<% content_for :title, @app.fqdn %>

<div class="page-head">
  <div>
    <h1><%= @app.name %></h1>
    <div class="page-head__meta">
      <% if @app.repo? %>
        <%= status_badge(status: :repo) %>
        <span class="mono"><%= @app.deploy_path %></span>
      <% else %>
        <%= status_badge(@status) %>
        <a href="<%= @app.url %>" target="_blank" rel="noopener" class="mono"><%= @app.fqdn %></a>
      <% end %>
    </div>
  </div>
  <div class="head-actions">
    <% if can?(:update, :apps) %>
      <%= button(text: "Deploy", href: deploy_app_path(@app), method: :post) %>
      <%= button(text: "Edit" , href: edit_app_path(@app), variant: :outline) %>
      <%= button(text: "Logs", href: logs_app_path(@app), variant: :outline) %>
      <%= button(text: "Exceptions", href: app_exception_groups_path(@app), variant: :outline) %>
      <% if @app.rails_app? %>
        <%= button(text: "Console", href: app_console_sessions_path(@app), method: :post, variant: :outline) %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="cols">
  <section class="card">
    <h2>Configuration</h2>
    <% if @app.repo? %>
      <dl class="kv">
        <dt>Checkout path</dt><dd class="mono"><%= @app.deploy_path %></dd>
        <dt>Source</dt><dd><%= @app.git_repo_url %> (<%= @app.git_branch %>)</dd>
        <dt>.env</dt><dd><%= @app.env_text.present? ? "#{@app.env_text.lines.count} lines" : "—" %></dd>
        <dt>Follow-up</dt>
        <dd>
          <% cmds = @app.post_deploy_command_list %>
          <% if cmds.empty? %>
            <span class="muted">none</span>
          <% else %>
            <ol class="mono"><% cmds.each { |c| %><li><%= c %></li><% } %></ol>
          <% end %>
        </dd>
      </dl>
      <% if can?(:delete, :apps) %>
        <div class="card__actions">
          <%= button(text: "Stop managing", href: app_path(@app), method: :delete, variant: :outline, class: "is-danger",
                     data: { turbo_confirm: teardown_warning(@app, @process_services) }) %>
        </div>
      <% end %>
    <% else %>
      <dl class="kv">
        <dt>Path</dt><dd class="mono"><%= @app.app_path %></dd>
        <dt>Document root</dt><dd class="mono"><%= @app.public_path %></dd>
        <dt>Ruby</dt><dd class="mono"><%= @app.ruby_version %></dd>
        <dt>Source</dt><dd><%= @app.git_repo_url %> (<%= @app.git_branch %>)</dd>
        <dt>Primary DB</dt><dd><%= @app.primary_db_kind %></dd>
        <dt>master.key</dt><dd><%= @app.master_key.present? ? "set" : "—" %></dd>
        <dt>.env</dt><dd><%= @app.env_text.present? ? "#{@app.env_text.lines.count} lines" : "—" %></dd>
      </dl>
      <%# Two very different outcomes behind one route, so the button has to say
          which one it is. AppsController#destroy only calls Plesk for a real
          subdomain: an apex domain IS the webspace, and `remove-subdomain` with
          a blank name would ask Plesk to delete the whole subscription, so that
          branch untracks and leaves the hosting alone. Labelling both "Delete
          app" told an apex site it was about to lose a subdomain it doesn't
          have. %>
      <% if can?(:delete, :apps) %>
        <div class="card__actions">
          <% if @app.apex? %>
            <%= button(text: "Stop managing", href: app_path(@app), method: :delete, variant: :outline, class: "is-danger",
                       data: { turbo_confirm: teardown_warning(@app, @process_services) }) %>
          <% else %>
            <%= button(text: "Delete app", href: app_path(@app), method: :delete, variant: :outline, class: "is-danger",
                       data: { turbo_confirm: teardown_warning(@app, @process_services) }) %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="card">
    <h2>
      Exceptions
      <% if @open_exception_count.positive? %><%= badge("#{@open_exception_count} open", tone: :danger) %><% end %>
    </h2>
    <% if @open_exceptions.empty? %>
      <p class="muted">No open exceptions. <%= link_to "History &amp; reporter setup →".html_safe, app_exception_groups_path(@app) %></p>
    <% else %>
      <ul class="exceptions">
        <% @open_exceptions.each do |group| %>
          <li>
            <%= link_to app_exception_group_path(@app, group) do %>
              <span class="exc-head"><span class="exc-class"><%= group.exception_class %></span></span>
              <span class="exc-count">×<%= group.events_count %> · <%= time_ago_in_words(group.last_seen_at) %></span>
              <span class="exc-message"><%= truncate(group.message, length: 100) %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
      <div class="card__actions"><%= link_to "All exceptions →", app_exception_groups_path(@app) %></div>
    <% end %>
  </section>

  <section class="card">
    <h2>
      Auto-deploy
      <%= @app.auto_deploy? ? badge("on", tone: :ok) : badge("off") %>
    </h2>

    <dl class="kv">
      <dt>Payload URL</dt>
      <dd class="mono break"><%= api_webhook_url(token: @app.webhook_token) %></dd>
      <dt>Content type</dt><dd class="mono">application/json</dd>
      <dt>Secret</dt>
      <dd>
        <% if @app.webhook_secret.present? %>
          set — <span class="muted">pushes are only accepted with a matching signature</span>
        <% else %>
          <%= badge("not set", tone: :danger) %>
          <span class="muted">— every delivery is rejected until you add one in Edit</span>
        <% end %>
      </dd>
      <dt>Branch</dt>
      <dd class="mono"><%= @app.webhook_branch.presence || @app.git_branch %></dd>
    </dl>

    <% if @deliveries.present? %>
      <ul class="rows card__list">
        <% @deliveries.each do |d| %>
          <li>
            <div class="row-line">
              <%= badge(d.status, tone: d.status == "deployed" ? :ok : :neutral) %>
              <strong class="mono"><%= d.short_sha.presence || d.event %></strong>
              <span class="muted">
                <%= d.branch.presence %>
                <%= "· #{d.pusher}" if d.pusher.present? %>
                · <%= time_ago_in_words(d.created_at) %>
              </span>
            </div>
            <% if d.message.present? %>
              <div class="row-note"><%= d.message %></div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted card__list">No deliveries received yet.</p>
    <% end %>
  </section>

  <section class="card">
    <h2>
      Workers <span class="chip"><%= @process_services.size %></span>
      <% if can?(:create, :apps) %>
        <span class="card__head-action">
          <%= button(text: "Add worker", href: new_process_service_path(app_id: @app.id), variant: :outline) %>
        </span>
      <% end %>
    </h2>
    <% if @process_services.empty? %>
      <p class="muted">No workers tied to this app.</p>
    <% else %>
      <ul class="rows">
        <% @process_services.each do |service| %>
          <li>
            <%= link_to process_service_path(service) do %>
              <strong class="mono"><%= service.name %></strong>
              <span class="muted"><%= service.kind %></span>
              <% if service.adopted? %><%= badge("adopted") %><% end %>
              <% unless service.enabled? %><%= badge("retired") %><% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="card">
    <h2>Recent deployments</h2>
    <% if @deployments.empty? %>
      <p class="muted">No deployments yet.</p>
    <% else %>
      <ul class="rows">
        <% @deployments.each do |d| %>
          <li>
            <%= link_to app_deployment_path(@app, d) do %>
              <%= deployment_badge(d) %>
              <strong><%= d.kind %></strong>
              <span class="muted"><%= d.ref.to_s.first(10) %> · <%= time_ago_in_words(d.created_at) %><%= " · #{d.duration}s" if d.duration %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
