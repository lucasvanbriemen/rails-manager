    module_function

    def verb?(name) = VERBS.key?(name)

    def verbs = VERBS.keys

    def spec(name)
      VERBS[name] || raise(Invalid.new("unknown verb #{name.inspect}", "unknown_verb"))
    end

    # The single entry point the tests hammer. Pure: no filesystem, no socket,
    # no root. Returns a symbol-keyed hash with defaults applied.
    def validate!(verb, params, webspaces:)
      raise Invalid.new("verb must be a string", "unknown_verb") unless verb.is_a?(String)

      definition = spec(verb)
      given = normalize_keys(params)
      allowed = definition[:params]

      unknown = given.keys - allowed.keys
      # Hard error, never ignored. A request the agent half-understood is a
      # request the caller and the agent disagree about, and disagreements about
      # root operations are how the wrong thing gets deleted.
      raise Invalid, "#{verb}: unknown parameter(s) #{unknown.map(&:to_s).sort.join(', ')}" if unknown.any?

      allowed.each_with_object({}) do |(name, rules), out|
        if given.key?(name)
          out[name] = coerce!(name, given[name], rules, webspaces)
        elsif rules.key?(:default)
          out[name] = rules[:default]
        elsif rules[:required]
          raise Invalid, "#{verb}: missing required parameter #{name}"
        end

        enforce_manageable!(verb, definition, name, rules, out[name], webspaces) if out.key?(name)
      end
    end

    # JSON gives string keys; a direct caller may use symbols. Accept both, but
    # refuse a payload carrying both "fqdn" and :fqdn — which of the two the
    # agent acted on would depend on hash ordering.
    def normalize_keys(params)
      raise Invalid, "params must be an object" unless params.is_a?(Hash)

      params.each_with_object({}) do |(key, value), out|
        raise Invalid, "parameter names must be strings" unless key.is_a?(String) || key.is_a?(Symbol)

        sym = key.to_sym
        raise Invalid, "duplicate parameter #{sym}" if out.key?(sym)

        out[sym] = value
      end
    end

    def coerce!(name, value, rules, webspaces)
      case rules[:type]
      when :label        then Types.label!(name, value)
      when :version      then Types.version!(name, value)
      when :relpath      then Types.relpath!(name, value)
      when :url_path     then Types.url_path!(name, value)
      when :config_path  then Types.config_path!(name, value)
      when :text         then Types.text!(name, value)
      when :line         then Types.line!(name, value)
      when :bool         then Types.bool!(name, value)
      when :port         then Types.port!(name, value)
      when :size         then Types.size!(name, value)
      when :argv         then Types.argv!(name, value)
      when :env          then Types.env!(name, value)
      when :ip_list      then Types.ip_list!(name, value)
      when :enum         then Types.enum!(name, value, rules.fetch(:values))
      when :count        then Types.count!(name, value, min: rules.fetch(:min), max: rules.fetch(:max))
      # Read-only verbs (status, journal). Observable is deliberately narrower
      # than "is a well-formed unit name": handing the web tier the agent's own
      # journal would expose the audit trail of every privileged call, and
      # sshd's would expose usernames and source addresses.
      when :unit         then Units.observable!(name, value)
      when :managed_unit then Units.controllable!(name, value)
      when :domain       then known_domain!(name, value, webspaces)
      when :fqdn         then known_fqdn!(name, value, webspaces)
      else raise Failure, "schema bug: no such type #{rules[:type].inspect}"
      end
    end

    # A hostname the agent has no webspace for has no directory either, so it is
    # rejected here rather than deeper, where the absence would show up as a
    # confusing ENOENT on a path the caller never named.
    def known_domain!(name, value, webspaces)
      Types.hostname!(name, value)
      raise Invalid.new("#{name}: #{value} is not a webspace on this server", "unknown_domain") unless webspaces.domain?(value)

      value
    end

    def known_fqdn!(name, value, webspaces)
      Types.hostname!(name, value)
      raise Invalid.new("#{name}: #{value} belongs to no webspace on this server", "unknown_domain") unless webspaces.resolve(value)

      value
    end

    def enforce_manageable!(verb, definition, name, rules, value, webspaces)
      return unless definition[:mutating]

      domain = case rules[:type]
      when :domain then value
      when :fqdn   then webspaces.resolve(value)&.domain
      end
      return if domain.nil? || webspaces.manageable?(domain)

      raise Invalid.new("#{verb}: #{domain} is read-only for the manager (#{name}=#{value})", "not_manageable")
    end
  end

  # ---------------------------------------------------------------------------
  # Handlers — one method per verb, named after it. Every value they receive has
  # already been through the schema, so they contain no validation.
  # ---------------------------------------------------------------------------
  class Handlers
    PLESK          = "/usr/sbin/plesk".freeze
    SYSTEMCTL      = "/usr/bin/systemctl".freeze
    SUPERVISORCTL  = "/usr/bin/supervisorctl".freeze
    JOURNALCTL     = "/usr/bin/journalctl".freeze

    # What systemd.status reports. A fixed list rather than the whole property
    # set: `systemctl show` with no -p emits two hundred lines including the
    # unit's full environment, which is how a status call would become a way to
    # read RAILS_MASTER_KEY back out.
    UNIT_PROPERTIES = %w[
      Id LoadState ActiveState SubState UnitFileState MainPID NRestarts
      MemoryCurrent ExecMainStartTimestamp Result
    ].freeze

    # dir.ensure's whole vocabulary. `kind` selects a row; nothing in the
    # request contributes a path segment except the fqdn, which the webspace
    # table has already resolved.
    DIR_KINDS = {
      # 0750, NOT 02750. The unit sets RestrictSUIDSGID=yes, which makes any
      # mkdir carrying the setgid bit fail with EPERM even as root — so asking
      # for 02750 here does not produce a setgid directory, it produces no
      # directory at all, and then nginx refuses to start because its log path
      # does not exist. Setgid was only ever there so nginx's log FILES would
      # inherit the group; it is unnecessary, because nginx's master opens them
      # as root at 0644 and the manager reaches them by traversing this
      # directory as a member of SITE_LOG_GROUP.
      "logs"     => { under: :logs, mode: 0o750, owner: :root, group: SITE_LOG_GROUP },
      "releases" => { under: :site, name: "releases", mode: 0o750, owner: :site, group: SITE_GROUP },
      "shared"   => { under: :site, name: "shared",   mode: 0o750, owner: :site, group: SITE_GROUP }
    }.freeze

    def initialize(webspaces:, config:)
      @webspaces = webspaces
      @config    = config
    end

    def call(verb, params, timeout)
      send(method_for(verb), params, timeout)
    end

    # Verb names are dotted; method names cannot be. The mapping is mechanical
    # and the method must already exist, so a schema entry without a handler is
    # a startup check away from being caught (see CLI --check-config).
    def method_for(verb)
      name = :"verb_#{verb.tr('.', '_')}"
      raise Failure, "no handler for #{verb}" unless respond_to?(name, true)

      name
    end

    def handles?(verb) = respond_to?(:"verb_#{verb.tr(".", "_")}", true)

    private

    def verb_ping(_params, _timeout)
      { data: { "agent_version" => VERSION, "protocol" => PROTOCOL, "verbs" => Schema.verbs } }
    end

    def verb_plesk_domains(_params, timeout)
      res = plesk!([ PLESK, "db", "-Ne",
                    "SELECT d.name, COALESCE(h.www_root,'') FROM domains d " \
                    "LEFT JOIN hosting h ON h.dom_id = d.id ORDER BY d.name;" ], timeout)
      sites = res.out.each_line.filter_map do |line|
        fqdn, www_root = line.chomp.split("\t", 2)
        next if fqdn.to_s.strip.empty?

        { "fqdn" => fqdn.strip, "www_root" => www_root.to_s.strip }
      end
      { out: res.out, data: { "domains" => sites } }
    end

    def verb_plesk_subdomain_create(params, timeout)
      fqdn = "#{params[:subdomain]}.#{params[:domain]}"
      info = Exec.run([ PLESK, "bin", "subdomain", "--info", params[:subdomain], "-domain", params[:domain] ], timeout: timeout)
      return { out: "subdomain #{fqdn} already exists\n" } if info.ok

      res = plesk!([ PLESK, "bin", "subdomain", "--create", params[:subdomain], "-domain", params[:domain] ], timeout)
      { out: res.out, err: res.err }
    end

    def verb_plesk_subdomain_docroot(params, timeout)
      fqdn = "#{params[:subdomain]}.#{params[:domain]}"
      # The www-root is composed here, from a hostname the schema proved and a
      # suffix that cannot contain a dot or a slash-dot. The client never gets to
      # name a directory.
      www_root = params[:suffix].to_s.empty? ? fqdn : "#{fqdn}/#{params[:suffix]}"
      res = plesk!([ PLESK, "bin", "subdomain", "--update", params[:subdomain],
                    "-domain", params[:domain], "-www-root", www_root ], timeout)
      { out: res.out, err: res.err, data: { "www_root" => www_root } }
    end

    def verb_plesk_ruby_enable(params, timeout)
      # Two calls, not one: --enable turns Passenger on, --set-version pins it.
      # A subdomain created without both gets no Passenger block at all and
      # Apache serves the directory listing or 403s — the git.ltvb.nl trap.
      enable = plesk!([ PLESK, "ext", "ruby", "--enable", "-domain", params[:fqdn], "-version", params[:version] ], timeout)
      pin    = plesk!([ PLESK, "ext", "ruby", "--set-version", "-domain", params[:fqdn], "-version", params[:version] ], timeout)
      { out: [ enable.out, pin.out ].join, err: [ enable.err, pin.err ].join }
    end

    def verb_plesk_reconfigure(params, timeout)
      res = plesk!([ "/usr/local/psa/admin/sbin/httpdmng", "--reconfigure-domain", params[:fqdn] ], timeout)
      { out: res.out, err: res.err }
    end

    def verb_plesk_subdomain_remove(params, timeout)
      res = plesk!([ PLESK, "bin", "subdomain", "--remove", params[:subdomain], "-domain", params[:domain] ], timeout)
      { out: res.out, err: res.err }
    end

    def verb_jobs_restart(_params, timeout)
      # --no-block is mandatory. The caller is itself a job inside this service,
      # so a blocking restart waits on the worker that is waiting on this call —
      # deadlocked until SIGKILL. Queuing it lets Solid Queue finish the deploy
      # and shut down cleanly before systemd starts the new worker.
      res = Exec.run([ SYSTEMCTL, "restart", "--no-block", "ltvb-apps-jobs" ], timeout: timeout)
      raise Failure.new("systemctl restart failed: #{res.err}", "exec") unless res.ok

      { out: "queued restart of ltvb-apps-jobs\n" }
    end

    # Post-Plesk site inventory, read from the filesystem the agent already
    # knows how to address. Directory names that are not "<label>.<domain>" are
    # skipped, which is what keeps logs/, bin/, error_docs/ and the assorted
    # ".bak" and ".laravel-leftovers" strays out of the list for free.
    def verb_sites_discover(_params, _timeout)
      sites = @webspaces.domains.flat_map do |domain|
        hostnames = [ domain ] + subdomain_dirs(domain)
        hostnames.filter_map { |fqdn| describe_site(fqdn) }
      end
      { data: { "sites" => sites } }
    end

    def verb_services_discover(_params, timeout)
      { data: { "systemd" => systemd_units(timeout), "supervisor" => supervisor_programs(timeout) } }
    end

    # Loopback with the real Host header and SNI. Going out to the public DNS
    # name would test the network; going to 127.0.0.1 with ipaddr= tests THIS
    # server's vhost selection, which is the thing that breaks during a
    # migration — and it reaches the staging ports (9080/9443) that are firewalled
    # off from outside.
    def verb_http_check(params, timeout)
      site = @webspaces.resolve(params[:fqdn])
      http = Net::HTTP.new(site.fqdn, params[:port])
      http.ipaddr      = "127.0.0.1"
      http.use_ssl     = params[:tls]
      http.verify_mode = OpenSSL::SSL::VERIFY_NONE # migration hosts serve self-signed until certbot lands
      http.open_timeout = [ timeout, 10 ].min
      http.read_timeout = [ timeout, 10 ].min

      started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      response = http.start { |c| c.get(params[:path]) }
      body = response.body.to_s

      { data: {
        "code" => response.code.to_i,
        "elapsed_ms" => ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round,
        "headers" => response.to_hash.slice("location", "content-type", "server", "x-request-id", "x-runtime", "x-powered-by"),
        "body_bytes" => body.bytesize,
        # A prefix only. The manager classifies (placeholder page, Rails, PHP
        # error); the agent stays a transport and never grows opinions that
        # would need a protocol bump to change.
        "body_head" => body.byteslice(0, 2048).to_s.force_encoding(Encoding::UTF_8).scrub("?")
      } }
      # A health probe that fails is a RESULT, not an agent failure: connection
      # refused, a TLS handshake error and a timeout are all things the manager
      # asked about and needs reported, not exceptions. The class name goes into
      # the payload so a genuine bug in here is still visible rather than
      # disguised as "the site is down".
    rescue StandardError => e
      { data: { "code" => nil, "error" => "#{e.class}: #{e.message}" } }
    end

    # --- nginx -----------------------------------------------------------------

    def verb_nginx_site_write(params, timeout)
      site = @webspaces.resolve(params[:fqdn])
      text = render_site(site, params)
      path = site_conf_path(site.fqdn)

      # The validator gets the STAGED file, which is named "<fqdn>.conf.new" and
      # therefore matches no include glob — so `nginx -t` at that moment would
      # test the tree without it and pass regardless. The real check is the
      # reload, which is test-then-reload and rolls back; this is only the cheap
      # structural gate that keeps an obviously truncated render off disk.
      AtomicWrite.replace(path, text, mode: 0o644,
                                      validate: ->(staged) { balanced_config?(staged) },
                                      reload: -> { nginx_reload(timeout) })
      { out: "wrote #{path}\n", data: { "path" => path, "bytes" => text.bytesize } }
    end

    def verb_nginx_site_remove(params, timeout)
      path  = site_conf_path(params[:fqdn])
      state = AtomicWrite.remove(path, reload: -> { nginx_reload(timeout) })

      { out: "#{path}: #{state}\n", data: { "path" => path, "state" => state.to_s } }
    end

    # A failing `nginx -t` is a RESULT, not an agent failure — it is the whole
    # question the caller asked. The exit status comes back in the payload.
    def verb_nginx_test(_params, timeout)
      res = Exec.run([ NGINX_BIN, "-t", "-c", NGINX_CONF ], timeout: timeout)
      { out: res.out, err: res.err, data: { "ok" => res.ok } }
    end

    def verb_nginx_reload(_params, timeout)
      raise Failure.new("nginx refused to reload; see nginx.test", "validation") unless nginx_reload(timeout)

      { out: "nginx configuration tested and reloaded\n" }
    end

    # --- systemd ---------------------------------------------------------------

    def verb_systemd_unit_install(params, timeout)
      site = @webspaces.resolve(params[:fqdn])
      unit = unit_name(site, params[:worker])
      text = render_unit(site, unit, params)
      path = File.join(SYSTEMD_DIR, unit)

      # 0600: an app unit's Environment= carries RAILS_MASTER_KEY, and eight
      # internet-facing apps share uid 10006 on this box.
      AtomicWrite.replace(path, text, mode: 0o600,
                                      validate: ->(staged) { unit_shaped?(staged) },
                                      reload: -> { daemon_reload(timeout) && unit_loaded?(unit, timeout) })
      { out: "installed #{path}\n", data: { "unit" => unit, "path" => path, "bytes" => text.bytesize } }
    end

    def verb_systemd_unit_remove(params, timeout)
      unit = params[:unit]
      # Best effort: a unit that was never enabled, or whose file a human
      # already deleted, must not be able to keep the file on disk.
      Exec.run([ SYSTEMCTL, "disable", "--now", unit ], timeout: timeout)
      state = AtomicWrite.remove(File.join(SYSTEMD_DIR, unit), mode: 0o600,
                                                               reload: -> { daemon_reload(timeout) })

      { out: "#{unit}: #{state}\n", data: { "unit" => unit, "state" => state.to_s } }
    end

    def verb_systemd_daemon_reload(_params, timeout)
      raise Failure.new("systemctl daemon-reload failed", "exec") unless daemon_reload(timeout)

      { out: "daemon-reload\n" }
    end

    def verb_systemd_enable(params, timeout)
      systemctl!([ "enable" ] + (params[:now] ? [ "--now" ] : []) + [ params[:unit] ], timeout)
    end

    def verb_systemd_disable(params, timeout)
      systemctl!([ "disable" ] + (params[:now] ? [ "--now" ] : []) + [ params[:unit] ], timeout)
    end

    def verb_systemd_restart(params, timeout)
      argv = [ params[:action] ]
      argv << "--no-block" unless params[:block]
      systemctl!(argv + [ params[:unit] ], timeout)
    end

    def verb_systemd_status(params, timeout)
      res = Exec.run([ SYSTEMCTL, "show", "-p", UNIT_PROPERTIES.join(","), params[:unit] ], timeout: timeout)
      properties = res.out.each_line.filter_map do |line|
        key, value = line.chomp.split("=", 2)
        [ key, value ] if key && value
      end.to_h

      { data: { "unit" => params[:unit], "properties" => properties } }
    end

    def verb_systemd_journal(params, timeout)
      res = Exec.run([ JOURNALCTL, "-u", params[:unit], "-n", params[:lines].to_s,
                      "--no-pager", "--output=short-iso" ], timeout: timeout)
      { out: res.out, err: res.err, data: { "unit" => params[:unit], "lines" => params[:lines] } }
    end

    # --- php-fpm ---------------------------------------------------------------

    def verb_fpm_pool_write(params, timeout)
      site = @webspaces.resolve(params[:fqdn])
      text = render_template("fpm-pool",
                              fqdn:         site.fqdn,
                              user:         site.owner,
                              group:        SITE_GROUP,
                              socket:       fpm_socket(site.fqdn),
                              socket_group: WEB_GROUP,
                              max_children: params[:max_children],
                              memory_limit: params[:memory_limit],
                              error_log:    File.join(SITE_LOG_ROOT, site.fqdn, "php-fpm.log"))
      path = pool_path(params[:php], site.fqdn)

      AtomicWrite.replace(path, text, mode: 0o644,
                                      validate: ->(staged) { File.size?(staged).to_i.positive? },
                                      reload: -> { fpm_reload(params[:php], timeout) })
      { out: "wrote #{path}\n", data: { "path" => path, "php" => params[:php] } }
    end

    def verb_fpm_reload(params, timeout)
      raise Failure.new("php#{params[:php]}-fpm refused to reload", "validation") unless fpm_reload(params[:php], timeout)

      { out: "php#{params[:php]}-fpm tested and reloaded\n" }
    end

    # --- directories -----------------------------------------------------------

    def verb_dir_ensure(params, _timeout)
      site = @webspaces.resolve(params[:fqdn])
      rule = DIR_KINDS.fetch(params[:kind])
      path = rule[:under] == :logs ? File.join(SITE_LOG_ROOT, site.fqdn) : File.join(site.root, rule[:name])
      uid  = rule[:owner] == :root ? 0 : uid_of(site.owner)

      created = ensure_dir!(path, rule[:mode], uid, gid_of(rule[:group]))
      { out: "#{path}: #{created ? 'created' : 'already present'}\n",
        data: { "path" => path, "created" => created } }
    end

    # --- helpers ---------------------------------------------------------------

    def plesk!(argv, timeout)
      res = Exec.run(argv, timeout: timeout)
      raise Failure.new("#{File.basename(argv.first)} timed out after #{timeout}s", "timeout") if res.timed_out
      raise Failure.new(res.err.empty? ? res.out : res.err, "exec") unless res.ok

      res
    end

    def subdomain_dirs(domain)
      suffix = ".#{domain}"
      Dir.children(File.join(VHOSTS_ROOT, domain)).select { |name| name.end_with?(suffix) && @webspaces.resolve(name) }.sort
    rescue SystemCallError
      []
    end

    def describe_site(fqdn)
      site = @webspaces.resolve(fqdn)
      return nil unless site && File.directory?(site.root)

      docroot = File.directory?(File.join(site.root, "public")) ? "public" : ""
      {
        "fqdn" => site.fqdn, "domain" => site.domain, "owner" => site.owner,
        "apex" => site.apex, "manageable" => site.manageable,
        "root" => site.root, "docroot_suffix" => docroot,
        "kind" => guess_kind(site.root),
        "plesk_vhost" => File.directory?(File.join(PLESK_SYSTEM, site.fqdn)),
        "certificate" => certificate(site.fqdn)
      }
    end

    # A guess, labelled as one. The manager stores the authoritative app_kind;
    # this exists so a host nobody has registered yet shows up with a sensible
    # default instead of "unknown".
    def guess_kind(root)
      return "rails"   if File.file?(File.join(root, "config", "environment.rb"))
      return "laravel" if File.file?(File.join(root, "artisan"))
      return "php"     if File.file?(File.join(root, "index.php")) || File.file?(File.join(root, "public", "index.php"))
      return "static"  if File.file?(File.join(root, "index.html")) || File.file?(File.join(root, "public", "index.html"))

      "unknown"
    end

    # /etc/letsencrypt is root-only, so this is one of the things only the agent
    # can answer — and expiry is exactly what the manager needs to alarm on.
    def certificate(fqdn)
      pem = File.read(File.join(LETSENCRYPT, fqdn, "cert.pem"))
      cert = OpenSSL::X509::Certificate.new(pem)
      { "present" => true, "not_after" => cert.not_after.utc.iso8601,
        "issuer" => cert.issuer.to_utf8, "subject" => cert.subject.to_utf8 }
    rescue Errno::ENOENT, Errno::EACCES, OpenSSL::X509::CertificateError
      { "present" => false }
    end

    # --- rendering -------------------------------------------------------------
    #
    # Everything below composes paths from the webspace table and from compiled
    # in constants. The request contributes an fqdn, a handful of booleans and a
    # value from a closed enum — never a path, never a fragment of config.

    # Keyword form at the call sites, one positional hash at the boundary, so a
    # handler reads as a list of named values instead of a hash literal.
    def render_template(name, **vars) = Templates.render(name, vars)

    def site_conf_path(fqdn) = File.join(NGINX_SITES, "#{fqdn}.conf")
    def fpm_socket(fqdn)     = File.join(PLESK_SYSTEM, fqdn, "php-fpm.sock")
    def app_socket(fqdn)     = File.join(APP_RUN_ROOT, fqdn, APP_SOCKET)
    def pool_path(version, fqdn) = File.join(PHP_ROOT, version, "fpm", "pool.d", "#{fqdn}.conf")
    def fpm_unit(version)    = "php#{version}-fpm.service"
    def fpm_bin(version)     = "/usr/sbin/php-fpm#{version}"
    def fpm_conf(version)    = File.join(PHP_ROOT, version, "fpm", "php-fpm.conf")

    # One render call against one template, because there used to be two of each
    # and they drifted: the index-precedence fix reached the manager's copy and
    # not this one, and only the site that happened to be re-rendered afterwards
    # picked it up — admin. and login.rijschool-mos.nl still carried
    # `index index.php index.html` while student. carried the fix.
    #
    # Everything below is a path composed from the webspace table and from
    # compiled-in constants, or a boolean the schema already checked. The
    # template does the rest, including both server blocks, so there is no
    # composition step here for the manager's preview to reimplement differently.
    def render_site(site, params)
      ports = params[:staging] ? STAGING_PORTS : LIVE_PORTS

      Templates.render("nginx-site", site_variables(site, params, ports))
    end

    # A hash rather than keywords: this is a contract with a second renderer
    # (NginxConfig, which previews and tests exactly these bytes), and a contract
    # is easier to diff as data than as an argument list.
    def site_variables(site, params, ports)
      {
        fqdn: site.fqdn, kind: params[:kind], staging: params[:staging],
        tls: params[:tls], redirect_http: params[:redirect_http],
        default_server: params[:default_server],
        http_port: ports[:http], https_port: ports[:https],
        # HSTS is scoped to the host and not the port, so a max-age sent from
        # :9443 would pin the real site too.
        hsts: params[:hsts] && !params[:staging], hsts_max_age: HSTS_MAX_AGE,
        client_max_body: CLIENT_MAX_BODY,
        cert_dir: File.join(LETSENCRYPT, site.fqdn),
        log_dir:  File.join(SITE_LOG_ROOT, site.fqdn),
        # Live and staging share a directory but not a file: the point of staging
        # is to compare the two, which is impossible once they interleave.
        log_prefix: params[:staging] ? "staging-" : "",
        acme_root: ACME_WEBROOT, docroot: document_root(site, params[:suffix]),
        allow: params[:allow],
        app_socket: app_socket(site.fqdn), fpm_socket: fpm_socket(site.fqdn),
        cable_path: params[:cable_path].to_s,
        # An app that cables from its own process leaves the port off and gets
        # its own socket rather than a second one.
        cable_upstream: params[:cable_port] ? "http://127.0.0.1:#{params[:cable_port]}" : "http://unix:#{app_socket(site.fqdn)}:",
        xaccel_location: XACCEL_LOCATION, xaccel_root: params[:xaccel].to_s
      }
    end

    def document_root(site, suffix)
      suffix.to_s.empty? ? site.root : File.join(site.root, suffix)
    end

    # --- unit rendering --------------------------------------------------------

    # Derived, never sent. "ltvb-app@git.ltvb.nl.service" is an instance-specific
    # file that shadows the template, so the unit needs no %i handling; a worker
    # gets a plain name because its identity has two parts and pushing both
    # through systemd's instance escaping buys nothing.
    def unit_name(site, worker)
      name = worker ? "ltvb-#{worker}-#{site.fqdn.tr('.', '-')}.service" : "ltvb-app@#{site.fqdn}.service"
      Units.controllable!(:unit, name)
    end

    def render_unit(site, unit, params)
      workdir = document_root(site, params[:workdir])
      shared  = { description: unit_description(params[:description], unit),
                  user: site.owner, group: SITE_GROUP, working_directory: workdir,
                  environment: environment_lines(params[:env]), memory_max: params[:memory_max] }

      if params[:worker]
        # The schema cannot say "required only when worker is set", so the
        # handler does — as an Invalid, which is the caller's fault and comes
        # back with the same code a schema rejection would.
        raise Invalid, "argv: required when worker is given" if params[:argv].nil?

        Templates.render("systemd-worker", shared.merge(exec_start: exec_line(params[:argv])))
      else
        raise Invalid, "ruby: required for an app unit" if params[:ruby].nil?
        raise Invalid, "argv: an app unit's command is derived, not sent" if params[:argv]

        Templates.render("systemd-app",
                         shared.merge(runtime_directory: "#{File.basename(APP_RUN_ROOT)}/#{site.fqdn}",
                                      exec_start: exec_line(puma_argv(params[:ruby], app_socket(site.fqdn)))))
      end
    end

    def puma_argv(ruby, socket)
      # `-b` on the command line replaces the binds from config/puma.rb; without
      # it every app's stock `port ENV.fetch("PORT") { 3000 }` would also open
      # TCP 3000 and only the first app to boot would get it.
      #
      # umask=0007 leaves the socket group-writable so nginx (a member of the
      # app's group) can connect, while the 0750 runtime directory keeps every
      # other local user out. login.ltvb.nl's only protection is an IP allowlist
      # in the vhost, and a world-connectable socket routes straight around it.
      [ "#{RBENV_ROOT}/versions/#{ruby}/bin/bundle", "exec", "puma",
        "-e", "production", "-b", "unix://#{socket}?umask=0007" ]
    end

    # One Environment="KEY=value" payload per entry. The whole assignment is
    # quoted so spaces and `#` survive, and `%` is doubled because systemd
    # expands specifiers (%h, %i) inside Environment= values.
    def environment_lines(env)
      env.map { |key, value| %("#{unit_quote("#{key}=#{value}")}") }
    end

    # `$` is doubled on top of that, because systemd DOES expand $FOO in Exec
    # lines even inside quotes, and an argument is data — never a reference.
    def exec_line(argv)
      argv.map { |arg| %("#{unit_quote(arg).gsub('$', '$$')}") }.join(" ")
    end

    # Block form, so the replacement's own backslash escapes never apply; the
    # backslash is handled in the same pass as the quote for the same reason.
    def unit_quote(value)
      value.gsub(/[\\"]/) { |char| "\\#{char}" }.gsub("%", "%%")
    end

    def unit_description(text, unit)
      line = text.to_s.strip
      line = "#{unit} (managed by apps.ltvb.nl)" if line.empty?
      line.gsub("%", "%%")
    end

    # --- validate and reload ---------------------------------------------------

    def balanced_config?(staged)
      text = File.read(staged)
      !text.strip.empty? && text.count("{") == text.count("}")
    end

    def unit_shaped?(staged)
      text = File.read(staged)
      text.include?("[Unit]") && text.include?("[Service]")
    end

    def nginx_reload(timeout)
      return false unless Exec.run([ NGINX_BIN, "-t", "-c", NGINX_CONF ], timeout: timeout).ok
      # Reload only what is running. Until the cutover, ltvb-nginx is not up and
      # Apache still serves; refusing every site write until then would mean the
      # tree could never be built in the first place, and at that point a clean
      # `nginx -t` IS the whole check.
      return true unless unit_active?(NGINX_UNIT, timeout)

      Exec.run([ SYSTEMCTL, "reload", NGINX_UNIT ], timeout: timeout).ok
    end

    def fpm_reload(version, timeout)
      return false unless Exec.run([ fpm_bin(version), "-t", "-y", fpm_conf(version) ], timeout: timeout).ok
      return true unless unit_active?(fpm_unit(version), timeout)

      Exec.run([ SYSTEMCTL, "reload", fpm_unit(version) ], timeout: timeout).ok
    end

    def daemon_reload(timeout) = Exec.run([ SYSTEMCTL, "daemon-reload" ], timeout: timeout).ok

    # systemd's own verdict on the file it just read. A unit with a bad setting
    # comes back "error" or "bad-setting" and would otherwise sit on disk
    # looking installed until the first person tried to start it.
    def unit_loaded?(unit, timeout)
      res = Exec.run([ SYSTEMCTL, "show", "-p", "LoadState", "--value", unit ], timeout: timeout)
      res.ok && res.out.strip == "loaded"
    end

    def unit_active?(unit, timeout)
      Exec.run([ SYSTEMCTL, "is-active", "--quiet", unit ], timeout: timeout).ok
    end

    def systemctl!(argv, timeout)
      res = Exec.run([ SYSTEMCTL ] + argv, timeout: timeout)
      raise Failure.new("systemctl #{argv.join(' ')} timed out after #{timeout}s", "timeout") if res.timed_out
      raise Failure.new(res.err.empty? ? res.out : res.err, "exec") unless res.ok

      { out: res.out.empty? ? "systemctl #{argv.join(' ')}\n" : res.out, err: res.err }
    end

    # --- filesystem ------------------------------------------------------------

    def ensure_dir!(path, mode, uid, gid)
      created = false
      stat = begin
        File.lstat(path)
      rescue Errno::ENOENT
        # mkdir, not mkdir_p. Every parent here is a compiled-in constant that
        # root created at install time, so a missing one means the agent is
        # wrong about the shape of the machine — and quietly papering over that
        # is how a log directory ends up somewhere nobody rotates.
        Dir.mkdir(path, mode)
        created = true
        File.lstat(path)
      end
      raise Failure, "#{path}: exists and is not a directory" unless stat.directory?

      # Unconditionally, not only on create: a directory that lost its setgid
      # bit or its group silently stops being writable by the app that needs it,
      # and "ensure" has to mean the end state, not the creation event.
      File.chmod(mode, path)
      File.chown(uid, gid, path)
      created
    end

    def uid_of(name)
      Etc.getpwnam(name.to_s).uid
    rescue ArgumentError
      raise Failure, "user #{name.inspect} does not exist on this system"
    end

    def gid_of(name)
      Etc.getgrnam(name.to_s).gid
    rescue ArgumentError
      raise Failure, "group #{name.inspect} does not exist on this system"
    end

    def systemd_units(timeout)
      res = Exec.run([ SYSTEMCTL, "list-units", "--type=service", "--all", "--plain",
                      "--no-legend", "--no-pager" ], timeout: timeout)
      return [] unless res.ok

      globs = @config["service_globs"]
      res.out.each_line.filter_map do |line|
        unit, load_state, active, sub, *description = line.split
        next unless unit && globs.any? { |glob| File.fnmatch?(glob, unit) }

        { "unit" => unit, "load" => load_state, "active" => active, "sub" => sub,
          "description" => description.join(" ") }
      end
    end

    # supervisorctl exits non-zero whenever any program is not RUNNING, so its
    # exit status says nothing useful; the output is parsed either way.
    def supervisor_programs(timeout)
      res = Exec.run([ SUPERVISORCTL, "status" ], timeout: timeout)
      res.out.each_line.filter_map do |line|
        name, state, *rest = line.split
        next unless name && state

        { "program" => name, "state" => state, "detail" => rest.join(" ") }
      end
    rescue Failure
      []
    end
  end

  # ---------------------------------------------------------------------------
  # Wire — NDJSON framing. Split out because the size limit is a security control
  # and deserves a test that does not need a socket.
  # ---------------------------------------------------------------------------
  module Wire
    module_function

    # nil at clean EOF. Anything longer than the cap is refused without being
    # buffered: gets(sep, limit) stops reading at the limit, so a client that
    # streams a gigabyte gets an error after a megabyte, not after a gigabyte.
    def read_line(io, limit: MAX_LINE_BYTES)
      line = io.gets("\n", limit)
      return nil if line.nil?
      raise Invalid.new("request exceeds #{limit} bytes", "oversize") unless line.end_with?("\n")

      line
    end

    def parse(line)
      request = JSON.parse(line, max_nesting: 8, create_additions: false)
      raise Invalid, "request must be a JSON object" unless request.is_a?(Hash)

      verb = request["verb"]
      raise Invalid.new("request has no verb", "unknown_verb") unless verb.is_a?(String)

      params = request.fetch("params", {})
      raise Invalid, "params must be an object" unless params.is_a?(Hash)

      extra = request.keys - %w[id verb params]
      raise Invalid, "request has unknown field(s) #{extra.sort.join(', ')}" if extra.any?

      [ request["id"].is_a?(String) ? request["id"] : nil, verb, params ]
    rescue JSON::ParserError => e
      raise Invalid, "malformed JSON: #{e.message}"
    end
  end

  # ---------------------------------------------------------------------------
  # Server
  # ---------------------------------------------------------------------------
  class Server
    # /run is tmpfs and root-owned, so the socket is recreated every boot. It is
    # created 0660 by umask rather than chmod'd afterwards: between bind() and
    # chmod() a 0777 socket is briefly open to every uid on the box.
    SOCKET_UMASK = 0o117

    # How long a mutating verb waits for the lock before telling the caller to
    # come back. Blocking forever turns one wedged deploy into a queue of them.
    LOCK_WAIT = 30

    def initialize(config: Config.load, webspaces: Webspaces.load, audit: Audit.new,
                   socket_path: SOCKET_PATH, lock_path: LOCK_PATH)
      @config      = config
      @webspaces   = webspaces
      @audit       = audit
      @socket_path = socket_path
      @lock_path   = lock_path
      @handlers    = Handlers.new(webspaces: webspaces, config: config)
      @allowed_uids = resolve_allowed_uids
      @running     = true
    end

    def run
      server = listen
      # Self-pipe: a signal must interrupt a blocking accept, and a trap handler
      # cannot safely do anything but write a byte.
      wake_r, @wake_w = IO.pipe
      trap("TERM") { shutdown }
      trap("INT")  { shutdown }
      trap("HUP")  { reload_requested }

      @audit.write("event" => "start", "agent_version" => VERSION, "protocol" => PROTOCOL,
                   "socket" => @socket_path, "allowed_uids" => @allowed_uids)

      while @running
        # EINTR is not an error here — a signal arrived, its handler ran, and
        # the next pass through the loop reads the self-pipe it wrote to.
        ready = begin
          IO.select([ server, wake_r ], nil, nil, 30)
        rescue Errno::EINTR
          nil
        end
        next unless ready

        drain(wake_r) if ready.first.include?(wake_r)
        next unless ready.first.include?(server) && @running

        accept_one(server)
      end
    ensure
      File.unlink(@socket_path) if @socket_path && File.socket?(@socket_path)
      @audit.write("event" => "stop")
    end

    # One connection at a time, on purpose. Root operations on a single small
    # server gain nothing from concurrency and lose the guarantee that two of
    # them never interleave; every verb has a deadline, so a slow call cannot
    # wedge the daemon indefinitely.
    def accept_one(server)
      conn = server.accept_nonblock(exception: false)
      return if conn == :wait_readable

      begin
        serve(conn)
      ensure
        conn.close unless conn.closed?
      end
      # One malformed connection must never take the daemon down: everything
      # that deploys, renews a certificate or restarts a service goes through
      # this socket, so an agent that exits on a surprise is an outage. The
      # audit line is what makes the surprise findable afterwards.
    rescue StandardError => e
      @audit.write("event" => "connection_error", "error" => "#{e.class}: #{e.message}",
                   "backtrace" => e.backtrace&.first(5))
    end

    def serve(conn)
      peer = peer_credentials(conn)
      unless permitted?(peer)
        @audit.write("event" => "denied", "peer" => peer,
                     "reason" => "uid not in allowed_uids #{@allowed_uids.inspect}")
        respond(conn, nil, error_response("caller uid #{peer['uid']} is not permitted", "denied"))
        return
      end

      # Several requests may share a connection, answered strictly in order.
      while (line = Wire.read_line(conn))
        id, verb, params = Wire.parse(line)
        respond(conn, id, dispatch(verb, params, peer))
      end
      # A framing or credentials error kills the connection rather than the
      # request: at this point the agent no longer knows where one request ends
      # and the next begins, so continuing to read would be guessing.
    rescue Invalid, Failure => e
      respond(conn, nil, error_response(e.message, e.code))
    rescue EOFError, Errno::ECONNRESET, Errno::EPIPE
      nil
    end

    def dispatch(verb, params, peer)
      redacted = nil
      spec = Schema.spec(verb)
      clean = Schema.validate!(verb, params, webspaces: @webspaces)
      redacted = Audit.redact(clean, spec[:params])

      if spec[:mutating]
        # Logged BEFORE the work, so a call that hangs the machine or kills the
        # agent still left a record of what was being attempted.
        @audit.write("event" => "call", "phase" => "start", "peer" => peer, "verb" => verb, "params" => redacted)
        with_lock { timed(verb, spec, clean, peer, redacted) }
      else
        timed(verb, spec, clean, peer, redacted)
      end
    rescue Invalid, Failure => e
      # `redacted` is nil when validation itself failed, and the rejected values
      # are then deliberately NOT logged — a value that failed validation is
      # exactly the kind of value not to copy into a root-owned log file.
      audit_result(peer, verb, redacted || rejected_keys(params), false, e.code, 0, e.message)
      error_response(e.message, e.code)
    end

    def timed(verb, spec, clean, peer, redacted)
      started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      result  = @handlers.call(verb, clean, spec[:timeout])
      ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round
      audit_result(peer, verb, redacted, true, nil, ms, nil)

      { "ok" => true, "out" => result[:out].to_s, "err" => result[:err].to_s,
        "data" => result[:data], "duration_ms" => ms }
    rescue Invalid, Failure => e
      ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round
      audit_result(peer, verb, redacted, false, e.code, ms, e.message)
      error_response(e.message, e.code)
      # The verbs that write files raise SystemCallError directly for the cases
      # nothing here can anticipate — ENOSPC, EROFS, a .bak someone replaced
      # with a symlink. Without this the exception escapes to accept_one, which
      # drops the connection: the caller then waits out its full timeout for a
      # failure the agent already knew about and could have named.
    rescue SystemCallError => e
      ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round
      audit_result(peer, verb, redacted, false, "io", ms, e.message)
      error_response("#{verb}: #{e.class}: #{e.message}", "io")
    end

    # Cross-process exclusion for mutating work. A second agent, a root shell
    # running the same helper, or a stuck previous call all serialise here — the
    # single-connection accept loop only protects against this daemon racing
    # itself.
    def with_lock
      File.open(@lock_path, File::RDWR | File::CREAT, 0o600) do |lock|
        deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + LOCK_WAIT
        until lock.flock(File::LOCK_EX | File::LOCK_NB)
          raise Failure.new("another privileged operation is in progress", "busy") if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

          sleep 0.25
        end
        yield
      end
    end

    # --- peer identity ---------------------------------------------------------

    # struct ucred { pid_t pid; uid_t uid; gid_t gid; } — three native 32-bit
    # words on Linux. This is the whole reason the daemon exists on a socket
    # rather than behind sudo: the kernel tells us who connected, and the answer
    # cannot be spoofed by the caller.
    def peer_credentials(conn)
      raw = conn.getsockopt(Socket::SOL_SOCKET, Socket::SO_PEERCRED)
      pid, uid, gid = raw.unpack("lLL")
      { "pid" => pid, "uid" => uid, "gid" => gid, "user" => username(uid) }
    rescue StandardError => e
      raise Failure.new("cannot read peer credentials: #{e.message}", "denied")
    end

    def permitted?(peer) = @allowed_uids.include?(peer["uid"])

    def username(uid)
      Etc.getpwuid(uid).name
    rescue ArgumentError
      nil
    end

    # Fail closed. An agent that starts with an empty allow-list would accept
    # nobody, which sounds safe — but it would also look healthy in systemd
    # while every deploy silently failed. Refuse to start instead.
    def resolve_allowed_uids
      uids = Array(@config["allowed_users"]).filter_map do |name|
        begin
          Etc.getpwnam(name.to_s).uid
        rescue ArgumentError
          nil
        end
      end
      raise Failure, "none of allowed_users #{@config['allowed_users'].inspect} exist on this system" if uids.empty?

      uids.uniq
    end

    # --- plumbing --------------------------------------------------------------

    def listen
      FileUtils.mkdir_p(File.dirname(@lock_path), mode: 0o755)
      remove_stale_socket
      previous = File.umask(SOCKET_UMASK)
      begin
        server = UNIXServer.new(@socket_path)
      ensure
        File.umask(previous)
      end
      File.chown(0, socket_gid, @socket_path)
      server
    end

    # Only ever unlinks something that is actually a socket. /run is root-only,
    # so this cannot be raced — but "delete whatever is at this path" is a habit
    # worth not having in a root daemon.
    def remove_stale_socket
      return unless File.exist?(@socket_path)
      raise Failure, "#{@socket_path} exists and is not a socket" unless File.socket?(@socket_path)

      File.unlink(@socket_path)
    end

    def socket_gid
      Etc.getgrnam(@config["socket_group"].to_s).gid
    rescue ArgumentError
      raise Failure, "socket group #{@config['socket_group'].inspect} does not exist"
    end

    def respond(conn, id, payload)
      conn.puts(JSON.generate(payload.merge("id" => id)))
    rescue Errno::EPIPE, Errno::ECONNRESET
      nil
    end

    def error_response(message, code)
      { "ok" => false, "out" => "", "err" => message, "code" => code, "data" => nil }
    end

    def audit_result(peer, verb, redacted, ok, code, ms, error)
      @audit.write("event" => "call", "phase" => "done", "peer" => peer, "verb" => verb,
                   "params" => redacted, "ok" => ok, "code" => code,
                   "duration_ms" => ms, "err" => error)
    end

    def rejected_keys(params)
      { "rejected_keys" => params.is_a?(Hash) ? params.keys.map(&:to_s).sort : [] }
    end

    def shutdown
      @running = false
      @wake_w&.write_nonblock(".", exception: false)
    end

    def reload_requested
      @reload = true
      @wake_w&.write_nonblock(".", exception: false)
    end

    def drain(io)
      io.read_nonblock(4096, exception: false)
      return unless @reload

      @reload = false
      @webspaces = Webspaces.load
      @config    = Config.load
      @handlers  = Handlers.new(webspaces: @webspaces, config: @config)
      @allowed_uids = resolve_allowed_uids
      @audit.write("event" => "reload", "allowed_uids" => @allowed_uids, "domains" => @webspaces.domains)
    rescue Failure => e
      # A bad config on reload leaves the OLD config running. Dropping to a
      # broken table mid-flight would be worse than ignoring the edit.
      @audit.write("event" => "reload_failed", "error" => e.message)
    end
  end

  # ---------------------------------------------------------------------------
  # CLI
  # ---------------------------------------------------------------------------
  module CLI
    module_function

    def run(argv)
      case argv[0]
      when nil       then Server.new.run
      when "--check" then check
      when "--verbs" then puts(JSON.pretty_generate(verb_table))
      when "--version" then puts("ltvb-agentd #{VERSION} (protocol #{PROTOCOL})")
      else
        warn("usage: ltvb-agentd [--check|--verbs|--version]")
        exit 64
      end
    rescue Failure, Invalid => e
      warn("ltvb-agentd: #{e.message}")
      exit 78 # EX_CONFIG
    end

    # ExecStartPre runs this: config parsed, users and group resolvable, and
    # every verb in the schema actually has a handler. A missing handler is a
    # 500 at deploy time otherwise, discovered by the person deploying.
    def check
      config    = Config.load
      webspaces = Webspaces.load
      handlers  = Handlers.new(webspaces: webspaces, config: config)

      missing = Schema.verbs.reject { |verb| handlers.handles?(verb) }
      raise Failure, "verbs without handlers: #{missing.join(', ')}" if missing.any?

      users = Array(config["allowed_users"]).to_h { |name| [ name, uid_of(name) ] }
      raise Failure, "no allowed_users resolve to a uid" if users.values.none?

      Etc.getgrnam(config["socket_group"].to_s)
      puts JSON.pretty_generate(
        "agent_version" => VERSION, "protocol" => PROTOCOL,
        "verbs" => Schema.verbs.size, "webspaces" => webspaces.domains,
        "allowed_users" => users, "socket_group" => config["socket_group"]
      )
    rescue ArgumentError => e
      raise Failure, "group #{config['socket_group'].inspect} missing (#{e.message})"
    end

    def uid_of(name)
      Etc.getpwnam(name.to_s).uid
    rescue ArgumentError
      nil
    end

    def verb_table
      Schema::VERBS.transform_values do |spec|
        {
          "summary" => spec[:summary], "mutating" => spec[:mutating], "timeout" => spec[:timeout],
          # Only the type is a Symbol; everything else is already JSON-safe and
          # stringifying it would turn `default: false` into the truthy "false".
          "params" => spec[:params].transform_values { |rules|
            rules.to_h { |key, value| [ key.to_s, value.is_a?(Symbol) ? value.to_s : value ] }
          }
        }
      end
    end
  end
end

# Guarded so the schema and the validators can be `load`ed by the test suite
# without starting a daemon. The tests are the reason every security decision in
# this file lives in a pure function.
LtvbAgent::CLI.run(ARGV) if $PROGRAM_NAME == __FILE__
