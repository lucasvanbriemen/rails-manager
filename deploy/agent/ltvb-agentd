#!/usr/bin/ruby
#
# ltvb-agentd — the root privilege boundary for the apps.ltvb.nl manager.
#
# Replaces sudo + /usr/local/sbin/ltvb-deployer. That was 137 lines of bash with
# 7 verbs; replacing Plesk needs roughly 45 (nginx, systemd units, php-fpm pools,
# certbot, postfix/dovecot maps, mailboxes, users). Bash at that size is a root
# shell with extra steps: one unquoted expansion, one `$(...)` in a value that
# came from a web form, and the boundary is gone. So the boundary is a daemon
# with a declarative schema instead of a script with hand-written `[[ ]]` guards.
#
# The five properties everything else here serves:
#
#   1. The caller is identified by SO_PEERCRED, not by filesystem permissions.
#      Six internet-facing apps share the `ltvb` uid, so socket group membership
#      proves almost nothing — any of those apps could open the socket. The
#      manager gets its own uid and only that uid is accepted.
#   2. Every verb declares its parameters. Unknown keys are a hard error: a typo
#      or a smuggled extra field must never be silently dropped, because "the
#      agent ignored it" is how a caller and a callee come to disagree about
#      what a request meant.
#   3. No path is ever a parameter. The client names an `fqdn`; the agent looks
#      the parent webspace up in ITS OWN table and builds the path. There is no
#      `..` check anywhere in this file because there is nothing to check —
#      a traversal would have to come from the table, which the web user cannot
#      write.
#   4. No config text comes from the web app. A verb takes a RENDER SPEC — a
#      kind from a closed enum, a suffix, some booleans — and the agent renders.
#      Templates are named by the handler, never by the request; each one is
#      compiled in here and may be overridden by a root-owned file under
#      /etc/ltvb/agent/templates. Rendering from the manager's checkout would
#      hand the web user a root-parsed file, which is exactly what it does when
#      the checkout is owned by a uid eight internet-facing apps share.
#   5. Writes are staged, validated, renamed, and reloaded — never restarted, and
#      never left broken: a failed reload restores the previous file and reloads
#      again.
#
# This file is deliberately stdlib-only and single-file: root installs it with
# `install`, and it is NEVER updated by an app deploy. The manager can rewrite
# its own checkout; if the checkout could rewrite the agent, the agent would be
# ornamental.
#
# Install (as root) — see deploy/agent/README.md for the full recipe.

require "digest"
require "erb"
require "etc"
require "fileutils"
require "ipaddr"
require "json"
require "net/http"
require "openssl"
require "socket"
require "time"
require "uri"

module LtvbAgent
  # Bumped by hand when the wire contract changes in a way a client must notice:
  # a verb removed, a parameter's meaning changed, a response field dropped.
  # Adding a verb or an optional parameter does not bump it — the client checks
  # the verb list for what it needs.
  PROTOCOL = 1
  VERSION  = "1.0.0".freeze

  SOCKET_PATH = "/run/ltvb-agent.sock".freeze
  LOCK_PATH   = "/run/ltvb-agent/lock".freeze
  AUDIT_PATH  = "/var/log/ltvb-agent/audit.log".freeze
  CONFIG_DIR  = "/etc/ltvb/agent".freeze

  VHOSTS_ROOT   = "/var/www/vhosts".freeze
  LETSENCRYPT   = "/etc/letsencrypt/live".freeze
  PLESK_SYSTEM  = "/var/www/vhosts/system".freeze

  # --- the post-Plesk tree ----------------------------------------------------
  # Every one of these is a compiled-in constant rather than a config value, for
  # the same reason no path is ever a parameter: these are the directories root
  # writes into, and the set of them is a property of the machine's design, not
  # something a caller — or a config file the caller could one day influence —
  # gets to move.

  # nginx 1.30.4, rescued from the Plesk packaging before it was removed, with
  # its own tree so nothing here depends on /etc/nginx surviving the uninstall.
  NGINX_BIN     = "/usr/local/sbin/ltvb-nginx".freeze
  NGINX_CONF    = "/etc/ltvb/nginx/nginx.conf".freeze
  NGINX_SITES   = "/etc/ltvb/nginx/sites".freeze
  NGINX_UNIT    = "ltvb-nginx.service".freeze

  SYSTEMD_DIR   = "/etc/systemd/system".freeze
  # RuntimeDirectory=ltvb-app/<fqdn> in the app unit creates this; the vhost
  # proxies into it. Both sides derive the socket from the fqdn so they cannot
  # drift into a 502 with no log line explaining it.
  APP_RUN_ROOT  = "/run/ltvb-app".freeze
  APP_SOCKET    = "puma.sock".freeze

  # 2750 root:ltvb-log, one directory per site. nginx refuses to START when a
  # directory named in access_log/error_log is missing, so dir.ensure has to run
  # before the first site file is written — not after.
  SITE_LOG_ROOT = "/var/log/ltvb/sites".freeze
  SITE_LOG_GROUP = "ltvb-log".freeze
  # Primary group of all six webspace owners (gid 1003) — what a unit runs as.
  SITE_GROUP    = "psacln".freeze
  # The group the web server is in (gid 1002). Only it may open an fpm socket.
  WEB_GROUP     = "psaserv".freeze

  # Apache's XSendFile took a filesystem path in the response header; nginx's
  # X-Accel-Redirect takes a URI, and this is the URI namespace an app sends
  # paths under. The template renders it as an `internal` location, so the
  # outside world cannot request the prefix directly.
  XACCEL_LOCATION = "/_x-accel/".freeze

  # The system-wide rbenv that replaces the six per-webspace .rbenv trees the
  # Plesk Ruby extension created.
  RBENV_ROOT    = "/opt/rbenv".freeze

  # Debian's php-fpm layout: /etc/php/<version>/fpm/pool.d/<fqdn>.conf, one
  # master unit per version. The pools themselves are already per-domain.
  PHP_ROOT      = "/etc/php".freeze
  PHP_VERSIONS  = %w[8.2 8.3 8.4].freeze

  # One shared webroot for http-01, so renewal never depends on an individual
  # site's document root existing or being readable.
  ACME_WEBROOT  = "/var/www/vhosts/default/htdocs".freeze

  # 182.5 days — the value lucasvanbriemen.nl already sends. Lowering it would
  # not take effect for anyone who has already pinned the longer one.
  HSTS_MAX_AGE  = 15_768_000
  # nginx's 1m default silently 413s music.ltvb.nl's uploads, which Apache
  # accepted. FPM and Rails both enforce their own limits behind this.
  CLIENT_MAX_BODY = "512m".freeze

  LIVE_PORTS    = { http: 80,   https: 443  }.freeze
  STAGING_PORTS = { http: 9080, https: 9443 }.freeze

  # One request line is capped well below anything a legitimate verb sends. The
  # cap exists so a hostile or wedged client cannot make the agent buffer until
  # the box OOMs; a real config blob is a few KB.
  MAX_LINE_BYTES = 1024 * 1024

  # Raised for anything the caller did wrong. `code` is machine-readable so the
  # manager can distinguish "you sent nonsense" from "the server is busy".
  class Invalid < StandardError
    attr_reader :code

    def initialize(message, code = "schema")
      super(message)
      @code = code
    end
  end

  # Raised when the agent itself could not complete the work (exec failure,
  # timeout, a rollback that did not take). Never the caller's fault.
  class Failure < StandardError
    attr_reader :code

    def initialize(message, code = "internal")
      super(message)
      @code = code
    end
  end

  # ---------------------------------------------------------------------------
  # Types — the whole trust boundary, in one place, with no side effects.
  #
  # Every one of these is a pure predicate so the adversarial test suite can hit
  # them directly, without root and without a socket. If a type is wrong, the
  # daemon is wrong, and a test that needs a unix socket to prove it is a test
  # nobody runs.
  # ---------------------------------------------------------------------------
  module Types
    # Anchored with \A..\z, never ^..$. With ^..$ the string "git.ltvb.nl\nrm -rf /"
    # matches a "safe hostname" pattern, because ^ and $ match around the newline.
    # That single character is the difference between a hostname and a command.
    HOSTNAME = /\A(?=.{1,253}\z)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\z/
    LABEL    = /\A[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\z/
    VERSION  = /\A[0-9]{1,4}(?:\.[0-9]{1,4}){0,3}\z/

    # A document-root suffix such as "public" or "httpdocs/public". Dots are not
    # merely filtered here — they are not in the alphabet at all, so ".." cannot
    # be spelled. At most two segments, because every real value on this server
    # is one or two and an unbounded depth is an unbounded surface. Each segment
    # must START alphanumeric, or "--version" is a legal suffix and every
    # command that ever receives one reads it as a flag.
    RELPATH = %r{\A[a-z0-9][a-z0-9_-]{0,63}(?:/[a-z0-9][a-z0-9_-]{0,63})?\z}

    # A request path for http.check. No spaces (would split a request line), no
    # control characters, and no fragment.
    URL_PATH = %r{\A/[A-Za-z0-9\-._~!$&'()*+,;=:@%/?]{0,1024}\z}

    # C0 and C1 controls except tab and newline. Rejected everywhere, in addition
    # to the per-type regexes, so a new type added later cannot forget: NUL
    # truncates in every C library the agent shells out to, CR forges a second
    # line in any line-oriented config, and ESC drives the operator's terminal
    # when they read the audit log.
    STRICT_CONTROLS = /[\x00-\x1F\x7F-\u009F]/
    TEXT_CONTROLS   = /[\x00-\x08\x0B-\x1F\x7F-\u009F]/

    # A systemd MemoryMax= / a php memory_limit. Bounded digits, so "999\u20269" is
    # not a way to spend the parser's time either.
    SIZE = /\A(?:\d{1,6}[KMG]?|infinity)\z/

    # An IPv4/IPv6 literal or CIDR block, and nothing that could be a hostname.
    IP_CIDR = %r{\A[0-9A-Fa-f.:]{2,45}(?:/[0-9]{1,3})?\z}

    ENV_KEY  = /\A[A-Za-z_][A-Za-z0-9_]{0,127}\z/
    ABSOLUTE = %r{\A/[A-Za-z0-9._+@:/-]*\z}

    MAX_SCALAR_BYTES = 4096
    MAX_TEXT_BYTES   = 64 * 1024
    MAX_LIST         = 32
    MAX_ARGV         = 32
    MAX_ENV_KEYS     = 64

    module_function

    # Common gate for every string parameter, whatever its type.
    def scalar!(name, value, max: MAX_SCALAR_BYTES, newlines: false)
      raise Invalid, "#{name}: expected a string, got #{value.class}" unless value.is_a?(String)
      # JSON hands us UTF-8, but "\ud800" (a lone surrogate) parses into bytes
      # that are not valid UTF-8. Anything downstream that regex-matches or
      # shells out on those bytes behaves unpredictably, so reject at the door.
      raise Invalid, "#{name}: not valid UTF-8" unless value.encoding == Encoding::UTF_8 && value.valid_encoding?
      raise Invalid, "#{name}: exceeds #{max} bytes" if value.bytesize > max

      pattern = newlines ? TEXT_CONTROLS : STRICT_CONTROLS
      raise Invalid, "#{name}: contains control characters" if pattern.match?(value)

      value
    end

    def hostname!(name, value)
      scalar!(name, value)
      raise Invalid, "#{name}: not a hostname" unless HOSTNAME.match?(value)

      value
    end

    def label!(name, value)
      scalar!(name, value)
      raise Invalid, "#{name}: not a DNS label" unless LABEL.match?(value)

      value
    end

    def version!(name, value)
      scalar!(name, value)
      raise Invalid, "#{name}: not a version" unless VERSION.match?(value)

      value
    end

    def relpath!(name, value)
      scalar!(name, value)
      raise Invalid, "#{name}: not a document-root suffix" unless value.empty? || RELPATH.match?(value)

      value
    end

    def url_path!(name, value)
      scalar!(name, value)
      raise Invalid, "#{name}: not a request path" unless URL_PATH.match?(value)

      value
    end

    # A path that gets rendered into a config directive rather than sent in a
    # request. URL_PATH is the right shape for http.check, where the value ends
    # up in a request line, but far too permissive for something interpolated
    # into `location <%= cable_path %> {` — it allows ';', '{', '$', '~' and
    # '..', which are directive terminators, variables, a regex-location marker
    # and traversal respectively. nginx -t would catch most of it and
    # AtomicWrite would roll back, but "the config fails to parse" is a poor
    # last line of defence for a value the web tier chose. Matches the
    # manager-side App validation, so the two cannot drift apart silently.
    CONFIG_PATH = %r{\A/[A-Za-z0-9._~/-]{0,255}\z}

    def config_path!(name, value)
      scalar!(name, value)
      ok = CONFIG_PATH.match?(value) && !value.include?("..")
      raise Invalid, "#{name}: not a plain config path" unless ok

      value
    end

    # Free text (a rendered .env, a key). Newlines and tabs are the point; every
    # other control is still refused.
    def text!(name, value)
      scalar!(name, value, max: MAX_TEXT_BYTES, newlines: true)
    end

    def bool!(name, value)
      raise Invalid, "#{name}: expected true or false" unless value == true || value == false

      value
    end

    def port!(name, value)
      # true is an Integer in neither Ruby nor JSON, but 1.0 is a Float that ==
      # 1, and "80" is a String that looks like a port. Neither is accepted:
      # a caller that cannot send an integer has a bug worth surfacing.
      raise Invalid, "#{name}: expected an integer" unless value.is_a?(Integer)
      raise Invalid, "#{name}: not a port" unless value.between?(1, 65_535)

      value
    end

    # A closed set declared by the verb. This is how a render spec stays a spec
    # rather than becoming config text: the client picks "rails" from a list the
    # agent wrote, and the agent decides what that means.
    def enum!(name, value, values)
      scalar!(name, value)
      raise Invalid, "#{name}: must be one of #{values.join(', ')}" unless values.include?(value)

      value
    end

    def count!(name, value, min:, max:)
      raise Invalid, "#{name}: expected an integer" unless value.is_a?(Integer)
      raise Invalid, "#{name}: must be between #{min} and #{max}" unless value.between?(min, max)

      value
    end

    def size!(name, value)
      scalar!(name, value)
      raise Invalid, "#{name}: not a size (e.g. 512M, 1G, infinity)" unless SIZE.match?(value)

      value
    end

    # allow/deny take a literal address or CIDR. A hostname would make nginx
    # resolve at load time and then silently permit whatever that name points at
    # afterwards, so only literals are accepted. IPAddr is asked last: it is
    # liberal about forms this server never uses ("10", "0x7f000001"), and the
    # regex is what pins the shape down.
    def ip!(name, value)
      scalar!(name, value, max: 64)
      raise Invalid, "#{name}: #{value.inspect} is not an address or CIDR" unless IP_CIDR.match?(value)

      begin
        IPAddr.new(value)
      rescue StandardError
        raise Invalid, "#{name}: #{value.inspect} is not an address or CIDR"
      end

      value
    end

    def ip_list!(name, value)
      list!(name, value, MAX_LIST)
      value.each_with_index { |entry, i| ip!("#{name}[#{i}]", entry) }
      value
    end

    # An argv array, never a command string: with no shell anywhere in Exec,
    # there is nothing for a `;` or a backtick in an element to escape into. The
    # one exception is systemd's own separator, which is compared after quotes
    # are stripped and would silently append a second ExecStart command line.
    def argv!(name, value)
      list!(name, value, MAX_ARGV)
      raise Invalid, "#{name}: is empty" if value.empty?

      value.each_with_index do |arg, i|
        scalar!("#{name}[#{i}]", arg)
        raise Invalid, "#{name}[#{i}]: is blank" if arg.empty?
        raise Invalid, "#{name}[#{i}]: is a bare command separator" if arg == ";"
      end
      unless ABSOLUTE.match?(value.first)
        raise Invalid, "#{name}[0]: must be an absolute path, got #{value.first.inspect}"
      end

      value
    end

    # Environment pairs for a unit file. Newlines are refused rather than
    # escaped: systemd parses a unit line by line, so a value of
    # "x\nExecStartPre=/bin/sh -c curl…" does not corrupt a value — it adds a
    # command root runs. There is no quoting that makes that safe.
    def env!(name, value)
      raise Invalid, "#{name}: expected an object" unless value.is_a?(Hash)
      raise Invalid, "#{name}: more than #{MAX_ENV_KEYS} keys" if value.size > MAX_ENV_KEYS

      total = 0
      value.each do |key, item|
        raise Invalid, "#{name}: key #{key.inspect} is not an environment variable name" unless key.is_a?(String) && ENV_KEY.match?(key)

        scalar!("#{name}[#{key}]", item)
        total += key.bytesize + item.bytesize
      end
      raise Invalid, "#{name}: exceeds #{MAX_TEXT_BYTES} bytes in total" if total > MAX_TEXT_BYTES

      value
    end

    # One line of free text (a unit Description=). No newlines, so it cannot
    # grow a second directive; length-capped so it cannot grow a unit file.
    def line!(name, value)
      scalar!(name, value, max: 200)
    end

    def list!(name, value, max)
      raise Invalid, "#{name}: expected an array" unless value.is_a?(Array)
      raise Invalid, "#{name}: more than #{max} entries" if value.size > max

      value
    end
  end

  # ---------------------------------------------------------------------------
  # Units — which systemd units this agent will read, and the much smaller set
  # it will act on.
  #
  # Two tiers on purpose. `readable!` is wide because status and journal output
  # are diagnostics and a wrong guess there costs nothing. `controllable!` is a
  # short list of shapes, because start/stop/enable/restart on an arbitrary unit
  # would let a compromised manager stop sshd or the firewall — not privilege
  # escalation, but an outage it could not be talked out of.
  # ---------------------------------------------------------------------------
  module Units
    # <name>[@<instance>].<type>. Anchored, lowercase, and no slash anywhere, so
    # a unit name can never be read as a path by systemctl.
    NAME = /\A[a-z0-9][a-z0-9_-]{0,200}(?:@[a-z0-9][a-z0-9.-]{0,126})?\.(?:service|timer|socket)\z/

    # Real units on this box whose names predate the pattern: Debian's php-fpm
    # masters put the version (with a dot) in the unit name, and postfix's
    # default instance is literally "-". Deliberately an enumeration and not a
    # looser regex — a legacy exception that can match names nobody has seen is
    # not an exception, it is the new rule.
    LEGACY = %w[
      php8.2-fpm.service php8.3-fpm.service php8.4-fpm.service postfix@-.service
    ].freeze

    # Everything the manager installs, plus the two git.ltvb.nl workers it
    # inherited and the php-fpm masters a pool write has to reload.
    CONTROLLABLE = [
      /\Altvb-app@[a-z0-9][a-z0-9.-]{0,126}\.service\z/,
      /\Altvb-[a-z0-9][a-z0-9_-]{0,200}\.service\z/,
      /\Agit-ltvb-[a-z0-9-]{1,32}\.service\z/,
      /\Aphp8\.[0-9]-fpm\.service\z/
    ].freeze

    # The agent must not be asked to stop the agent: the call that did it would
    # be the last one answered, and nothing left running could start it again.
    NEVER = %w[ltvb-agent.service].freeze

    # Units the manager may only OBSERVE (status/journal). Everything it can
    # control, plus the shared daemons whose health it legitimately reports on.
    #
    # Reading is not harmless, so this is an allowlist rather than "any unit
    # that isn't controllable":
    #   * ltvb-agent.service is the privilege boundary — its journal carries the
    #     audit trail of every call made through it, including failures that
    #     quote the parameters that caused them.
    #   * sshd.service logs usernames and source addresses for every login and
    #     every failed attempt, which is a credential-adjacent feed the web tier
    #     has no reason to hold.
    # Neither appears below, deliberately.
    OBSERVABLE = [
      /\Anginx\.service\z/,
      /\Aapache2\.service\z/,
      /\Amariadb\.service\z/,
      /\Adovecot\.service\z/,
      /\Apostfix@-\.service\z/,
      /\Aredis-server\.service\z/,
      /\Asupervisor\.service\z/
    ].freeze

    module_function

    def name!(field, value)
      Types.scalar!(field, value, max: 255)
      ok = (NAME.match?(value) || LEGACY.include?(value)) && !value.include?("..") &&
           !value.include?("/") && !value.end_with?(".")
      raise Invalid, "#{field}: #{value.inspect} is not a unit name this agent recognises" unless ok

      value
    end

    def controllable!(field, value)
      name!(field, value)
      raise Invalid.new("#{field}: #{value} is not a unit this agent may control", "not_manageable") unless controllable?(value)

      value
    end

    # status/journal. Strictly wider than controllable? and strictly narrower
    # than name! — a well-formed unit name is not on its own a reason to hand
    # its log to the web tier.
    def observable!(field, value)
      name!(field, value)
      raise Invalid.new("#{field}: #{value} is not a unit this agent may read", "not_readable") unless observable?(value)

      value
    end

    def controllable?(value)
      return false if NEVER.include?(value)

      CONTROLLABLE.any? { |pattern| pattern.match?(value) }
    end

    def observable?(value)
      return false if NEVER.include?(value)

      controllable?(value) || OBSERVABLE.any? { |pattern| pattern.match?(value) }
    end
  end

  # ---------------------------------------------------------------------------
  # Webspaces — the agent's own map from hostname to directory.
  #
  # This is property 3. The client sends "git.ltvb.nl"; this table says that
  # ltvb.nl is a webspace owned by `ltvb`, so the site lives at
  # /var/www/vhosts/ltvb.nl/git.ltvb.nl. The client never names a directory, so
  # there is no traversal to defend against.
  #
  # `manageable` preserves the policy the bash wrapper enforced with its
  # ALLOWED_DOMAINS array: only the two domains we own outright accept mutating
  # verbs. The four customer webspaces are readable (discovery, health checks)
  # but not writable, and flipping that is a root edit of webspaces.json — not a
  # code change and not something the manager can ask for.
  # ---------------------------------------------------------------------------
  class Webspaces
    Site = Struct.new(:fqdn, :domain, :owner, :root, :manageable, :apex, keyword_init: true)

    DEFAULT = {
      "ltvb.nl"                => { "owner" => "ltvb",                          "manageable" => true },
      "lucasvanbriemen.nl"     => { "owner" => "lucasvanbriemen.nl_p8c08835y9j", "manageable" => true },
      "djtim.eu"               => { "owner" => "djtim.eu_aqwzxapl85w",           "manageable" => false },
      "rijschool-mos.nl"       => { "owner" => "rijschool-mos.nl_gze6m7rrghq",   "manageable" => false },
      "voordezorgmanagement.nl" => { "owner" => "voordezorgmanagement._rhc4zy0iyc", "manageable" => false },
      "mos-safeguards.com"     => { "owner" => "mos-safeguards.com_eea0inbcx8t",  "manageable" => false }
    }.freeze

    def self.load(path = File.join(CONFIG_DIR, "webspaces.json"))
      new(Config.read_json(path) || DEFAULT)
    end

    def initialize(table)
      @table = table.each_with_object({}) do |(domain, attrs), out|
        # A malformed table is a boot failure, not a runtime surprise: if this
        # map is wrong every path the agent derives is wrong.
        raise Failure, "webspaces: #{domain.inspect} is not a hostname" unless Types::HOSTNAME.match?(domain.to_s)

        out[domain.to_s] = {
          owner:      attrs["owner"].to_s,
          manageable: attrs["manageable"] == true
        }
      end.freeze
    end

    def domains = @table.keys

    def domain?(name) = @table.key?(name)

    def manageable?(domain) = @table.dig(domain, :manageable) == true

    def owner(domain) = @table.dig(domain, :owner)

    # nil when the hostname belongs to no webspace we run. That is the only way
    # a path gets built, so an unknown hostname simply has no path.
    def resolve(fqdn)
      return nil unless fqdn.is_a?(String) && Types::HOSTNAME.match?(fqdn)

      if (entry = @table[fqdn])
        # The apex of a webspace serves from httpdocs, not from a directory
        # named after itself — Plesk's layout, and the migration keeps it.
        return site(fqdn, fqdn, entry, File.join(VHOSTS_ROOT, fqdn, "httpdocs"), apex: true)
      end

      parent = @table.keys.find { |d| fqdn.end_with?(".#{d}") }
      return nil unless parent

      # Exactly one label deep. Every hostname on this server is, and each extra
      # level is another chance for this table and the on-disk layout to disagree
      # about which directory a name means.
      return nil if fqdn.delete_suffix(".#{parent}").include?(".")

      site(fqdn, parent, @table[parent], File.join(VHOSTS_ROOT, parent, fqdn), apex: false)
    end

    private

    def site(fqdn, domain, entry, root, apex:)
      Site.new(fqdn: fqdn, domain: domain, owner: entry[:owner], root: root,
               manageable: entry[:manageable], apex: apex)
    end
  end

  # ---------------------------------------------------------------------------
  # Config — root-owned JSON, refused if anyone else can write it.
  # ---------------------------------------------------------------------------
  module Config
    DEFAULT = {
      # The uid allowed to call. `ltvb` is deliberately NOT here: six public apps
      # run as that uid, and any of them being compromised must not become root.
      # The manager gets a dedicated account (see README).
      "allowed_users" => [ "ltvb-manager" ],
      "socket_group"  => "ltvb-agent",
      # services.discover only reports units matching these globs. A full unit
      # list leaks the shape of the machine to a web app for no benefit.
      "service_globs" => [
        "ltvb-*.service", "git-ltvb-*.service", "apache2.service", "nginx.service",
        "php*-fpm.service", "postfix*.service", "dovecot.service", "certbot*.service"
      ]
    }.freeze

    module_function

    def load(path = File.join(CONFIG_DIR, "agent.json"))
      DEFAULT.merge(read_json(path) || {})
    end

    # nil when absent — callers fall back to their compiled-in default so a fresh
    # install boots. Present-but-untrusted is fatal: silently ignoring a config
    # file an attacker just planted is worse than not booting.
    def read_json(path, owner: 0)
      Trusted.file!(path, owner: owner)
      JSON.parse(File.read(path), max_nesting: 8, create_additions: false)
    rescue Errno::ENOENT
      nil
    rescue JSON::ParserError => e
      raise Failure, "#{path}: invalid JSON (#{e.message})"
    end
  end

  # ---------------------------------------------------------------------------
  # Trusted — "root wrote this and only root can change it".
  #
  # Everything the agent reads as an instruction (its config, its templates) goes
  # through here. lstat, not stat: following a symlink and then asking who owns
  # the destination answers the wrong question, because the symlink itself is
  # what an attacker gets to plant.
  #
  # `owner` exists so the rules can be exercised by a test suite that is not
  # root. Production never passes it — 0 is the only value that ships.
  # ---------------------------------------------------------------------------
  module Trusted
    module_function

    def file!(path, owner: 0)
      stat = File.lstat(path)
      raise Failure, "#{path}: is a symlink" if stat.symlink?
      raise Failure, "#{path}: not a regular file" unless stat.file?
      raise Failure, "#{path}: not owned by uid #{owner}" unless stat.uid == owner
      raise Failure, "#{path}: writable by group or other" unless (stat.mode & 0o022).zero?

      path
    end
  end

  # ---------------------------------------------------------------------------
  # Templates — property 4.
  #
  # Config text is never a parameter. A handler names a template by a constant;
  # this resolves it under a root-owned directory and refuses anything that is
  # not a plain root-owned file. The symlink check is the point: /etc/ltvb is
  # root-only, but a template directory that ever became writable would otherwise
  # let a symlink turn "render nginx-site" into "render /home/attacker/site".
  # ---------------------------------------------------------------------------
  module Templates
    DIR = File.join(CONFIG_DIR, "templates").freeze

    # No leading dot, and every dot must be followed by an alphanumeric — so
    # "..", "." and "../x" are unspellable, and there is no separator to abuse.
    NAME = /\A[a-z0-9]+(?:[-.][a-z0-9]+)*\z/

    # Compiled into the daemon, which root installs, so a box with an empty
    # /etc/ltvb/agent/templates still serves sites. Same rule as Config: absent
    # falls back to the built-in, present-and-untrusted is fatal. The built-in
    # is the SAFER of the two — it cannot be edited without replacing the binary
    # root installed — so the fallback direction is deliberately this way round
    # and not "prefer whatever is on disk".
    DEFAULTS = {
      # ---- BEGIN GENERATED from deploy/templates/nginx/nginx-site.erb ----
      # Regenerate with `ruby deploy/agent/embed-nginx-template` after editing
      # the template. The manager renders the same file for its previews and
      # its tests, which is what makes a test failure here mean the config
      # this daemon writes is wrong.
      "nginx-site" => <<~'ERB',
        # Generated from nginx-site.erb — do not edit by hand; edit the App and
        # re-render. Requires the shared http{} config (log format, scrub maps, TLS
        # session zone) to be included before this file.
        #
        # <%= fqdn %> | kind: <%= kind %> | <%= staging ? "staging" : "live" %> (<%= http_port %>/<%= https_port %>)
        <%
          # Derived here rather than by the caller. This file is rendered from two
          # places — the agent, which writes the served config, and the manager, which
          # previews and tests it — and anything the two compute separately is a thing
          # they can eventually compute differently. That drift is what this template
          # exists to make impossible, so it keeps every derivation it can.

          # With tls off there is nowhere to redirect TO, so redirect_http is ignored
          # rather than obeyed into a loop.
          redirect = tls && redirect_http

          # Staging has to name its own port or the redirect bounces the browser
          # straight back to live Apache, which is exactly what staging is testing.
          https_suffix = staging ? ":#{https_port}" : ""

          listen_arg = lambda do |port, ssl:, ipv6:|
            parts = [ ipv6 ? "[::]:#{port}" : port.to_s ]
            parts << "default_server" if default_server
            parts << "ssl" if ssl
            parts.join(" ")
          end
        -%>
        <% (tls ? [ false, true ] : [ false ]).each do |https| -%>

        server {
            listen <%= listen_arg.call(https ? https_port : http_port, ssl: https, ipv6: false) %>;
            # IPv6 is not implied by the IPv4 listen. mos-safeguards.com served HTTPS on
            # v4 only for eight months because this line was missing from its vhost, and
            # every dual-stack client silently got a connection refused.
            listen <%= listen_arg.call(https ? https_port : http_port, ssl: https, ipv6: true) %>;
        <% if https -%>
            http2 on;
        <% end -%>

            server_name <%= fqdn %>;
        <% if https -%>

            ssl_certificate     <%= cert_dir %>/fullchain.pem;
            ssl_certificate_key <%= cert_dir %>/privkey.pem;

            ssl_protocols TLSv1.2 TLSv1.3;
            ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
            # The client's preference order is the better one on TLS 1.3 hardware: it
            # knows whether it has AES acceleration and we do not.
            ssl_prefer_server_ciphers off;

            # No ssl_stapling. Let's Encrypt retired its OCSP responder, so there is
            # nothing to staple, and turning it on would make every worker depend on a
            # resolver being reachable — a dependency that fails closed at reload time.
        <% end -%>

            # Per-site logs, split out of Plesk's shared /var/www/vhosts/system tree so a
            # site's logs survive the domain being reconfigured and can be rotated per
            # app. ltvb_scrubbed drops ?auth_token= before anything is written.
            access_log <%= log_dir %>/<%= log_prefix %>access.log ltvb_scrubbed;
            error_log  <%= log_dir %>/<%= log_prefix %>error.log warn;

            # nginx defaults to 1m and returns 413 with nothing in the app's log. Apache
            # had no limit here, so music.ltvb.nl's uploads would start failing on
            # cutover.
            client_max_body_size <%= client_max_body %>;
        <% if https && hsts -%>

            # `always` or nginx omits it on error responses, which is where a downgrade
            # would be attempted.
            add_header Strict-Transport-Security "max-age=<%= hsts_max_age %>; includeSubDomains" always;
        <% end -%>
        <% unless allow.empty? -%>

            # IP allowlist. These are server-level, so they are inherited by every
            # location that does not declare its own allow/deny — which is how the
            # acme-challenge location below opts back out without needing to be ordered
            # first.
        <% allow.each do |entry| -%>
            allow <%= entry %>;
        <% end -%>
            deny all;
        <% end -%>

            # http-01 renewal has to work on an IP-restricted site and on a site that
            # redirects everything to https, so it is a location of its own that re-opens
            # access explicitly (nginx inherits allow/deny only into levels that declare
            # none of their own). `^~` so it also wins over the dotfile regex below —
            # the challenge path is literally a dotfile directory.
            location ^~ /.well-known/acme-challenge/ {
                allow all;
                root <%= acme_root %>;
            }
        <% if redirect && !https -%>

            location / {
                return 301 https://$host<%= https_suffix %>$request_uri;
            }
        <% else -%>

            root <%= docroot %>;

            # Plesk denied dotfiles only under the challenge directory, but Apache's
            # stock config denies .ht* everywhere — which the staging stack did not, and
            # .htaccess came back 200 on mos-safeguards.com and voordezorgmanagement.nl
            # while Apache answered 403. Generalise it: a .git, .env or .htaccess that
            # lands in a document root must never be served. First regex location, so it
            # wins over the PHP handler below; the lookahead keeps /.well-known/
            # (security.txt, apple-app-site-association) reachable.
            location ~ /\.(?!well-known/) {
                deny all;
            }
        <% unless xaccel_root.empty? -%>

            # Apache's XSendFile, ported. The difference matters: XSendFile took a real
            # filesystem path in the response header, X-Accel-Redirect takes a URI. The
            # app must emit `X-Accel-Redirect: <%= xaccel_location %><relative path>`, NOT the
            # absolute path it sends today. `internal` means the outside world cannot
            # request this prefix directly — the app is still the only thing that can
            # authorise a file.
            location <%= xaccel_location %> {
                internal;
                alias <%= xaccel_root %>/;
            }
        <% end -%>
        <% unless cable_path.empty? -%>

            # Websocket endpoint. Apache forced HTTP/1.1 for the whole vhost to make this
            # work; nginx does not need that — the proxy leg is always HTTP/1.1
            # regardless of the client's protocol, and 1.25+ handles websockets over
            # HTTP/2 itself.
            location <%= cable_path %> {
                proxy_pass <%= cable_upstream %>;
                proxy_http_version 1.1;
                proxy_set_header Upgrade    $http_upgrade;
                # $ltvb_connection_upgrade, not a literal "upgrade": Connection must say
                # upgrade only when the client asked for it and close otherwise, or
                # keepalive breaks for every ordinary request sharing the connection.
                proxy_set_header Connection $ltvb_connection_upgrade;
                proxy_set_header Host       $host;
                proxy_set_header X-Real-IP  $remote_addr;
                proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
                # An idle socket is normal here; the 60s default would cull every quiet
                # tab.
                proxy_read_timeout 3600s;
                proxy_send_timeout 3600s;
                # Buffering a stream defeats the point of the stream.
                proxy_buffering off;
            }
        <% end -%>
        <% if kind == "rails" -%>

            index index.html;

            # Sprockets/Propshaft names are content-hashed, so a stale answer is
            # impossible and these never need to reach Puma. `expires` rather than
            # `add_header Cache-Control`: an add_header in a location replaces the whole
            # inherited set, which would silently drop the HSTS header on exactly the
            # requests a browser makes most often.
            location /assets/ {
                expires 1y;
                access_log off;
                try_files $uri =404;
            }

            location / {
                try_files $uri @app;
            }

            # Puma listens on a unix socket owned by ltvb-app@<%= fqdn %>.service. A socket
            # rather than a loopback port so the filesystem permissions decide who may
            # talk to the app, and so two apps can never collide on a port number.
            location @app {
                proxy_pass http://unix:<%= app_socket %>:;
                proxy_http_version 1.1;
                proxy_set_header Host              $host;
                proxy_set_header X-Real-IP         $remote_addr;
                proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
                # Rails' force_ssl and url_for read this. On the :80 block of a site that
                # legitimately serves plain http, $scheme is "http" and Rails must be
                # told the truth or it builds https URLs for a request that arrived over
                # http.
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_set_header X-Forwarded-Host  $host;
                # Redirects the app emits point at the socket URL otherwise.
                proxy_redirect off;
                proxy_read_timeout 120s;
            }
        <% elsif kind == "laravel" || kind == "php" -%>

            # index.html BEFORE index.php, matching this server's Apache DirectoryIndex
            # ("index.html" "index.cgi" "index.pl" "index.php" ...). The staging
            # comparison caught this: student.rijschool-mos.nl ships both, Apache serves
            # the .html and nginx served the .php, which redirected to a login page.
            # Whichever order is "better" in the abstract, a migration that silently
            # changes which page a site serves is a regression.
            index index.html index.php;

            location / {
        <% if kind == "laravel" -%>
                # Laravel's stock public/.htaccess front controller. nginx does not read
                # .htaccess at all, so leaving this out gives a working homepage and a
                # 404 on every other route — which looks like an app bug.
                try_files $uri $uri/ /index.php?$query_string;
        <% else -%>
                # No front controller: a request that names no real file is a 404, not a
                # rewrite. These sites have no router to hand it to.
                try_files $uri $uri/ =404;
        <% end -%>
            }

            # PHP-FPM. The pool is Plesk's, one per domain, running as the webspace owner
            # with its own open_basedir — that stays as it is; only the web server in
            # front of it changes.
            #
            # The fastcgi_param list is written out rather than `include fastcgi_params`:
            # that file belongs to Plesk's sw-nginx package, and this config has to keep
            # working after that package is removed.
            location ~ [^/]\.php(/|$) {
                fastcgi_split_path_info ^(.+?\.php)(/.*)$;
                # try_files resets $fastcgi_path_info, so stash it first. Documented
                # nginx behaviour, and the reason PATH_INFO silently goes empty in most
                # copied configs.
                set $ltvb_path_info $fastcgi_path_info;
                # The whole point of this line: without it, /uploads/photo.jpg/x.php
                # hands FPM a SCRIPT_FILENAME that resolves to the uploaded image and
                # executes it.
                try_files $fastcgi_script_name =404;

                fastcgi_pass unix:<%= fpm_socket %>;

                fastcgi_param SCRIPT_FILENAME   $document_root$fastcgi_script_name;
                fastcgi_param SCRIPT_NAME       $fastcgi_script_name;
                fastcgi_param PATH_INFO         $ltvb_path_info;
                fastcgi_param PATH_TRANSLATED   $document_root$ltvb_path_info;
                fastcgi_param DOCUMENT_ROOT     $document_root;
                fastcgi_param DOCUMENT_URI      $document_uri;
                fastcgi_param REQUEST_URI       $request_uri;
                fastcgi_param REQUEST_METHOD    $request_method;
                fastcgi_param QUERY_STRING      $query_string;
                fastcgi_param CONTENT_TYPE      $content_type;
                fastcgi_param CONTENT_LENGTH    $content_length;
                fastcgi_param SERVER_PROTOCOL   $server_protocol;
                fastcgi_param SERVER_NAME       $server_name;
                fastcgi_param SERVER_ADDR       $server_addr;
                fastcgi_param SERVER_PORT       $server_port;
                fastcgi_param SERVER_SOFTWARE   nginx;
                fastcgi_param GATEWAY_INTERFACE CGI/1.1;
                fastcgi_param REMOTE_ADDR       $remote_addr;
                fastcgi_param REMOTE_PORT       $remote_port;
                fastcgi_param REQUEST_SCHEME    $scheme;
                # if_not_empty: PHP treats HTTPS as on whenever the variable exists at
                # all, so passing an empty string would make every plain-http request
                # look secure.
                fastcgi_param HTTPS             $https if_not_empty;
                # Without this, a pool built with security.limit_extensions refuses to
                # run.
                fastcgi_param REDIRECT_STATUS   200;
                # httpoxy. A request carrying a Proxy header becomes HTTP_PROXY in the
                # CGI environment, which several HTTP client libraries then obey. Plesk's
                # fastcgi_params blanked it; this list has to as well.
                fastcgi_param HTTP_PROXY        "";

                fastcgi_hide_header X-Powered-By;
                # Laravel sessions and long Set-Cookie headers overflow the 4k default
                # and surface as an upstream-sent-too-big-header 502.
                fastcgi_buffer_size 32k;
                fastcgi_buffers 16 16k;
                fastcgi_read_timeout 300s;
            }
        <% elsif kind == "static" -%>

            index index.html index.htm;

            location / {
                try_files $uri $uri/ =404;
            }

            # Without a PHP handler nginx would serve a .php file as plain text — turning
            # a stray script from "not executed" into "source code published". 404
            # instead.
            location ~ [^/]\.php(/|$) {
                return 404;
            }
        <% end -%>
        <% end -%>
        }
        <% end -%>
      ERB
      # ---- END GENERATED ----

      # The per-app Puma. Every value here is escaped by the handler before it
      # arrives; the template interpolates and does not decide anything.
      "systemd-app" => <<~'ERB',
        # Generated by ltvb-agentd — do not edit by hand.
        # Install mode is 0600: this file carries RAILS_MASTER_KEY and six
        # unrelated webspace users share this box. That is necessary but not
        # sufficient — systemd republishes Environment= over D-Bus, so
        # `systemctl show -p Environment` reveals it to any local user. Moving
        # these to LoadCredential= is the real fix.
        [Unit]
        Description=<%= description %>
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=simple
        User=<%= user %>
        Group=<%= group %>
        WorkingDirectory=<%= working_directory %>
        # 0750, one directory per app, so a compromised app cannot reach another
        # app's socket. nginx has to traverse it and is a member of the group.
        RuntimeDirectory=<%= runtime_directory %>
        RuntimeDirectoryMode=0750
        <% environment.each do |line| -%>
        Environment=<%= line %>
        <% end -%>
        ExecStart=<%= exec_start %>
        ExecReload=/bin/kill -USR2 $MAINPID
        Restart=always
        RestartSec=3
        # A leaking app gets OOM-killed and restarted instead of taking the
        # other twenty-one hostnames down with it.
        MemoryMax=<%= memory_max %>
        NoNewPrivileges=yes
        PrivateTmp=yes
        ProtectSystem=full

        [Install]
        WantedBy=multi-user.target
      ERB

      "systemd-worker" => <<~'ERB',
        # Generated by ltvb-agentd — do not edit by hand.
        [Unit]
        Description=<%= description %>
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=simple
        User=<%= user %>
        Group=<%= group %>
        WorkingDirectory=<%= working_directory %>
        <% environment.each do |line| -%>
        Environment=<%= line %>
        <% end -%>
        ExecStart=<%= exec_start %>
        Restart=always
        RestartSec=5
        MemoryMax=<%= memory_max %>
        NoNewPrivileges=yes
        PrivateTmp=yes
        ProtectSystem=full

        [Install]
        WantedBy=multi-user.target
      ERB

      "fpm-pool" => <<~'ERB'
        ; Generated by ltvb-agentd — do not edit by hand.
        [<%= fqdn %>]
        user = <%= user %>
        group = <%= group %>

        ; The socket keeps Plesk's location so nothing has to move in the same
        ; step the web server does. 0660 root:<%= socket_group %>, because nginx
        ; connects to it and nobody else may.
        listen = <%= socket %>
        listen.owner = root
        listen.group = <%= socket_group %>
        listen.mode = 0660

        pm = ondemand
        pm.max_children = <%= max_children %>
        pm.process_idle_timeout = 60s
        pm.max_requests = 500

        catch_workers_output = yes
        php_admin_value[error_log] = <%= error_log %>
        php_admin_flag[log_errors] = on
        php_admin_value[memory_limit] = <%= memory_limit %>
      ERB
    }.freeze

    module_function

    # A template name is a constant in a handler, never a request parameter —
    # but it is validated anyway, because "no caller passes this yet" is a
    # property of today's verb list and not of this function.
    def path(name, dir: DIR, owner: 0)
      name!(name)

      Trusted.file!(File.join(dir, "#{name}.erb"), owner: owner)
    rescue Errno::ENOENT
      raise Invalid, "template: #{name} not installed"
    end

    def name!(name)
      raise Invalid, "template: bad name #{name.inspect}" unless name.is_a?(String) && NAME.match?(name)

      name
    end

    # An installed override wins, but only if it passes the trust check; absent
    # falls back to the built-in. An override that exists and is a symlink, or
    # is owned by anyone but root, or is group-writable, raises — silently
    # ignoring a template an attacker just planted is the one behaviour that
    # would make this whole module decorative.
    def source(name, dir: DIR, owner: 0)
      name!(name)
      installed = begin
        path(name, dir: dir, owner: owner)
        # "not installed" is the one case the built-in answers. A symlink or a
        # wrong owner comes back from Trusted as Failure and is deliberately NOT
        # caught here: silently rendering the built-in because someone planted a
        # template would make this whole module decorative.
      rescue Invalid
        return DEFAULTS[name] || raise(Invalid, "template: #{name} is neither installed nor built in")
      end

      File.read(installed)
    end

    # result_with_hash rather than a binding: the template gets exactly the
    # variables the handler passed and no access to the agent's own state.
    def render(name, vars, dir: DIR, owner: 0)
      ERB.new(source(name, dir: dir, owner: owner), trim_mode: "-").result_with_hash(vars)
    end
  end

  # ---------------------------------------------------------------------------
  # Exec — child processes with a deadline and no shell, ever.
  # ---------------------------------------------------------------------------
  module Exec
    MAX_OUTPUT = 256 * 1024
    TERM_GRACE = 5

    # Children get nothing from the agent's environment. LANG is pinned so
    # parsers here see the C locale's output rather than a translated one.
    CHILD_ENV = { "PATH" => "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                  "LANG" => "C.UTF-8", "LC_ALL" => "C.UTF-8" }.freeze

    Result = Struct.new(:ok, :out, :err, :timed_out)

    module_function

    def run(argv, timeout:)
      argv = Array(argv).map(&:to_s)
      # An absolute argv[0] means PATH cannot be steered into a hostile binary,
      # and it makes every command in this file greppable.
      raise Failure, "exec: argv[0] must be absolute (#{argv.first.inspect})" unless argv.first.to_s.start_with?("/")

      out_r, out_w = IO.pipe
      err_r, err_w = IO.pipe
      # [path, argv0] is the never-a-shell spawn form. Passing a bare string —
      # or a single-element array — can hand the command to /bin/sh, which is
      # precisely the failure mode this daemon exists to remove.
      pid = Process.spawn(CHILD_ENV, [ argv.first, argv.first ], *argv[1..],
                          in: :close, out: out_w, err: err_w,
                          pgroup: true, unsetenv_others: true, close_others: true)
      out_w.close
      err_w.close

      collect(pid, out_r, err_r, timeout)
      # A binary that is missing or not executable is an install problem, not a
      # crash: it must come back to the caller as a normal failed call so the
      # audit log records it and the connection survives.
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Failure.new("#{argv.first}: #{e.message}", "exec")
    ensure
      [ out_w, err_w, out_r, err_r ].each { |io| io&.close unless io&.closed? }
    end

    def collect(pid, out_r, err_r, timeout)
      deadline = now + timeout
      buffers  = { out_r => +"", err_r => +"" }
      open     = [ out_r, err_r ]
      timed_out = false

      until open.empty?
        remaining = deadline - now
        if remaining <= 0
          timed_out = true
          break
        end

        ready = IO.select(open, nil, nil, [ remaining, 0.25 ].min)
        next unless ready

        ready.first.each do |io|
          chunk = begin
            io.read_nonblock(64 * 1024)
          rescue IO::WaitReadable
            next
          rescue EOFError
            open.delete(io)
            next
          end
          # Truncate rather than grow without bound: a runaway child's stdout is
          # not worth the agent's address space, and 256 KB is far more than any
          # verb here legitimately produces.
          buffers[io] << chunk if buffers[io].bytesize < MAX_OUTPUT
        end
      end

      # Both pipes closing is not the same as the child exiting: a process that
      # closes its own stdout and then hangs would otherwise park the agent in a
      # blocking waitpid forever, past the deadline it was given.
      status = timed_out ? nil : reap_before(pid, deadline)
      timed_out ||= status.nil?
      status = kill_tree(pid) if timed_out

      Result.new(!timed_out && status&.success?, finish(buffers[out_r]), finish(buffers[err_r]), timed_out)
    end

    # nil when the deadline passed with the child still alive.
    def reap_before(pid, deadline)
      loop do
        _, status = Process.waitpid2(pid, Process::WNOHANG)
        return status if status
        return nil if now >= deadline

        sleep 0.05
      end
    rescue Errno::ECHILD
      nil
    end

    # The child was spawned into its own process group, so the whole tree dies —
    # a `plesk` invocation that forks helpers would otherwise leave them running
    # with the pipe still open after the agent gave up.
    def kill_tree(pid)
      Process.kill("TERM", -pid)
      grace = now + TERM_GRACE
      loop do
        _, status = Process.waitpid2(pid, Process::WNOHANG)
        return status if status
        break if now >= grace

        sleep 0.1
      end
      Process.kill("KILL", -pid)
      Process.waitpid2(pid).last
    rescue Errno::ESRCH, Errno::ECHILD
      nil
    end

    def finish(buffer)
      buffer.byteslice(0, MAX_OUTPUT).to_s.force_encoding(Encoding::UTF_8).scrub("?")
    end

    # Monotonic: a timeout must not be defeated by ntp stepping the wall clock.
    def now = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  end

  # ---------------------------------------------------------------------------
  # AtomicWrite — property 5.
  #
  #   stage <path>.new  ->  validate the staged file  ->  back up  ->  rename
  #   ->  reload  ->  if the reload refuses, put the old file back and reload again
  #
  # `reload` is expected to test-then-reload (`nginx -t && systemctl reload
  # nginx`): some validators only work on a whole tree, and a reload that
  # activates an untested tree is the thing this exists to prevent. Reload, never
  # restart — a restart drops every live connection to twenty-two sites to fix
  # one of them.
  # ---------------------------------------------------------------------------
  module AtomicWrite
    MAX_BACKUP_BYTES = 4 * 1024 * 1024

    module_function

    # `owner` is the testability seam described on Trusted; production is 0.
    def replace(path, content, validate:, reload:, mode: 0o644, owner: 0)
      staged = "#{path}.new"
      clear_staged!(staged, owner)
      write_staged(staged, content, mode)

      unless validate.call(staged)
        File.unlink(staged)
        raise Invalid.new("#{path}: rejected by validator", "validation")
      end

      backup = backup!(path, mode, owner)
      File.rename(staged, path)

      if reload.call
        # The .bak only ever existed for the rollback path and for a crash
        # between the rename and the reload. Neither can happen now, and the
        # first file this mechanism protects is a unit carrying
        # RAILS_MASTER_KEY — a second copy of that lying around indefinitely is
        # a worse outcome than losing an undo nobody uses.
        discard_backup!(path, owner)
        return :written
      end

      restore!(path, backup, reload, mode)
      raise Invalid.new("#{path}: reload refused the new file; previous version restored", "validation")
    end

    # Removing a site file is the same contract in reverse: keep a copy, unlink,
    # reload, and put it back if the reload refuses. Without this, "remove a
    # vhost" would be the one mutating path with no way back.
    def remove(path, reload:, owner: 0, mode: 0o644)
      backup = backup!(path, mode, owner)
      return :absent if backup.nil?

      File.unlink(path)
      if reload.call
        discard_backup!(path, owner)
        return :removed
      end

      restore!(path, backup, reload, mode)
      raise Invalid.new("#{path}: reload refused the removal; previous version restored", "validation")
    end

    # Never unlink blind. The parent directory is root-only, so an lstat here
    # cannot be raced; but a leftover `.new` that is a symlink or a directory
    # means something is wrong that a human should look at, not something to
    # quietly delete.
    def clear_staged!(staged, owner = 0)
      stat = begin
        File.lstat(staged)
      rescue Errno::ENOENT
        return
      end

      raise Failure, "#{staged}: exists and is not a plain file owned by uid #{owner} — refusing to touch it" unless stat.file? && stat.uid == owner

      File.unlink(staged)
    end

    # O_EXCL|O_NOFOLLOW: if anything at all appears at the staged path between
    # the check above and this open, the open fails instead of writing through a
    # symlink into a file we never meant to name.
    def write_staged(staged, content, mode)
      File.open(staged, File::WRONLY | File::CREAT | File::EXCL | File::NOFOLLOW, mode) do |f|
        f.write(content)
        f.flush
        f.fsync
      end
      File.chmod(mode, staged)
    end

    # Kept on disk as <path>.bak rather than only in memory, so a crash between
    # the rename and the reload still leaves the operator the old file.
    #
    # It is written with the SAME mode as the file it copies, and with
    # O_NOFOLLOW, for the same reasons write_staged is. File.binwrite would
    # create it 0644 under the default umask: the first file this protects is
    # ltvb-app@login.ltvb.nl.service, whose Environment= line is the only copy
    # of that app's RAILS_MASTER_KEY on the box, so a 0644 backup hands the key
    # to every one of the eight apps sharing uid 10006.
    def backup!(path, mode, owner = 0)
      stat = begin
        File.lstat(path)
      rescue Errno::ENOENT
        return nil
      end

      raise Failure, "#{path}: not a regular file" unless stat.file?
      raise Failure, "#{path}: too large to back up" if stat.size > MAX_BACKUP_BYTES

      content = File.binread(path)
      backup = "#{path}.bak"
      clear_staged!(backup, owner)
      File.open(backup, File::WRONLY | File::CREAT | File::EXCL | File::NOFOLLOW, mode) do |f|
        f.binmode
        f.write(content)
        f.flush
        f.fsync
      end
      # O_CREAT applies the mode only when it creates the file, and EXCL means
      # it always did — but umask still subtracts from it, so say it outright.
      File.chmod(mode, backup)
      content
    end

    # Only ever unlinks a plain file we own. Anything else at that path means
    # something is wrong that a human should see; the write itself already
    # succeeded, so this reports by leaving evidence rather than by raising and
    # calling a completed operation a failure.
    def discard_backup!(path, owner = 0)
      backup = "#{path}.bak"
      stat = begin
        File.lstat(backup)
      rescue Errno::ENOENT
        return
      end

      File.unlink(backup) if stat.file? && stat.uid == owner
    end

    # The same mode discipline as backup!: on the remove path the file has
    # already been unlinked, so this CREATES it, and a plain File.binwrite would
    # bring a 0600 unit back as 0644 — losing the protection precisely in the
    # situation where something has already gone wrong.
    def restore!(path, backup, reload, mode = 0o644)
      if backup
        File.open(path, File::WRONLY | File::CREAT | File::TRUNC | File::NOFOLLOW, mode) do |f|
          f.binmode
          f.write(backup)
        end
        File.chmod(mode, path)
      else
        File.unlink(path)
      end
      return if reload.call

      # Both the new file and the old one were refused. Nothing here can fix
      # that; say so loudly and leave the .bak in place.
      raise Failure.new("#{path}: restored the previous version but the reload still fails — manual repair needed", "broken")
    end
  end

  # ---------------------------------------------------------------------------
  # Audit — property 7. One JSON line per call, secrets by digest only.
  # ---------------------------------------------------------------------------
  class Audit
    def initialize(path = AUDIT_PATH)
      FileUtils.mkdir_p(File.dirname(path), mode: 0o750)
      @io = File.open(path, File::WRONLY | File::APPEND | File::CREAT, 0o600)
      @io.sync = true
    rescue SystemCallError
      # A daemon that cannot write its audit log must still refuse work rather
      # than work silently, so this is fatal at boot — but a rotated-away file
      # at runtime should not take root operations down with it.
      raise Failure, "cannot open audit log #{path}"
    end

    def write(event)
      @io.puts(JSON.generate(event.merge("ts" => Time.now.utc.iso8601(3))))
    rescue SystemCallError
      nil
    end

    def close = @io.close

    # Parameters flagged `secret: true` are recorded by name, digest and length.
    # The digest is enough to answer "did the key that broke production match
    # the one we stored?" without the audit log becoming a second copy of every
    # secret on the box — which is what a log of full parameters would be.
    def self.redact(params, spec)
      params.each_with_object({}) do |(key, value), out|
        if spec.dig(key.to_sym, :secret)
          # Canonical JSON for a map rather than Hash#to_s: the digest is
          # compared across deploys, and Ruby has changed how it inspects a
          # hash between versions. Key order is normalised for the same reason.
          text = value.is_a?(Hash) ? JSON.generate(value.sort_by { |k, _| k.to_s }.to_h) : value.to_s
          entry = { "param" => key.to_s, "sha256" => Digest::SHA256.hexdigest(text), "bytes" => text.bytesize }
          # A secret env block is a map, and WHICH variables were set is the
          # forensic question ("did this deploy stop setting DATABASE_URL?").
          # The names are not the secret; the values are, and those stay hashed.
          entry["keys"] = value.keys.map(&:to_s).sort if value.is_a?(Hash)
          out[key.to_s] = entry
        else
          out[key.to_s] = value
        end
      end
    end
  end

