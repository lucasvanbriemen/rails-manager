<% content_for :title, @app.fqdn %>

<div class="page-head">
  <div>
    <h1><%= @app.name %></h1>
    <div class="muted">
      <% if @app.repo? %>
        <span class="mono"><%= @app.deploy_path %></span> · <%= status_badge(status: :repo) %>
      <% else %>
        <a href="<%= @app.url %>" target="_blank" rel="noopener"><%= @app.fqdn %></a> · <%= status_badge(@status) %>
      <% end %>
    </div>
  </div>
  <div class="head-actions">
    <% if can?(:update, :apps) %>
      <%= button(text: "Deploy", href: deploy_app_path(@app), method: :post) %>
      <%= button(text: "Edit" , href: edit_app_path(@app)) %>
      <%= button(text: "Logs", href: logs_app_path(@app), variant: :outline) %>
      <%= button(text: "Exceptions", href: app_exception_groups_path(@app), variant: :outline) %>
      <% if @app.rails_app? %>
        <%= button(text: "Console", href: app_console_sessions_path(@app), method: :post, variant: :outline) %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="cols">
  <section class="card">
    <h2>Configuration</h2>
    <% if @app.repo? %>
      <dl class="kv">
        <dt>Checkout path</dt><dd class="mono"><%= @app.deploy_path %></dd>
        <dt>Source</dt><dd><%= @app.git_repo_url %> (<%= @app.git_branch %>)</dd>
        <dt>.env</dt><dd><%= @app.env_text.present? ? "#{@app.env_text.lines.count} lines" : "—" %></dd>
        <dt>Follow-up</dt>
        <dd>
          <% cmds = @app.post_deploy_command_list %>
          <% if cmds.empty? %>
            <span class="muted">none</span>
          <% else %>
            <ol class="mono"><% cmds.each { |c| %><li><%= c %></li><% } %></ol>
          <% end %>
        </dd>
      </dl>
      <% if can?(:delete, :apps) %>
        <%= button(text: "Stop managing", href: app_path(@app), method: :delete, form: { data: { turbo_confirm: "Stop managing #{@app.name}? The on-disk checkout is left in place." } }) %>
      <% end %>
    <% else %>
      <dl class="kv">
        <dt>Path</dt><dd class="mono"><%= @app.app_path %></dd>
        <dt>Document root</dt><dd class="mono"><%= @app.public_path %></dd>
        <dt>Ruby</dt><dd><code><%= @app.ruby_version %></code></dd>
        <dt>Source</dt><dd><%= @app.git_repo_url %> (<%= @app.git_branch %>)</dd>
        <dt>Primary DB</dt><dd><%= @app.primary_db_kind %></dd>
        <dt>master.key</dt><dd><%= @app.master_key.present? ? "set" : "—" %></dd>
        <dt>.env</dt><dd><%= @app.env_text.present? ? "#{@app.env_text.lines.count} lines" : "—" %></dd>
      </dl>
      <% if can?(:delete, :apps) %>
        <%= button(text: "Delete app", href: app_path(@app), method: :delete, form: { data: { turbo_confirm: "Remove subdomain #{@app.fqdn} and stop managing it?" } }) %>
      <% end %>
    <% end %>
  </section>

  <section class="card">
    <h2>Exceptions <% if @open_exception_count.positive? %><span class="badge badge--exc-open"><%= @open_exception_count %> open</span><% end %></h2>
    <% if @open_exceptions.empty? %>
      <p class="muted">No open exceptions. <%= link_to "History & reporter setup", app_exception_groups_path(@app) %></p>
    <% else %>
      <ul class="exceptions">
        <% @open_exceptions.each do |group| %>
          <li>
            <%= link_to app_exception_group_path(@app, group) do %>
              <strong class="mono"><%= group.exception_class %></strong>
              <span class="exc-message"><%= truncate(group.message, length: 80) %></span>
              <span class="muted">×<%= group.events_count %> · <%= time_ago_in_words(group.last_seen_at) %> ago</span>
            <% end %>
          </li>
        <% end %>
      </ul>
      <p><%= link_to "All exceptions →", app_exception_groups_path(@app) %></p>
    <% end %>
  </section>

  <section class="card">
    <h2>
      Auto-deploy
      <% if @app.auto_deploy? %>
        <span class="badge badge--rails">on</span>
      <% else %>
        <span class="badge">off</span>
      <% end %>
    </h2>

    <dl class="kv">
      <dt>Payload URL</dt>
      <dd class="mono break"><%= api_webhook_url(token: @app.webhook_token) %></dd>
      <dt>Content type</dt><dd class="mono">application/json</dd>
      <dt>Secret</dt>
      <dd>
        <% if @app.webhook_secret.present? %>
          set — <span class="muted">pushes are only accepted with a matching signature</span>
        <% else %>
          <span class="badge badge--error5xx">not set</span>
          <span class="muted">— every delivery is rejected until you add one in Edit</span>
        <% end %>
      </dd>
      <dt>Branch</dt>
      <dd><code><%= @app.webhook_branch.presence || @app.git_branch %></code></dd>
    </dl>

    <% if @deliveries.present? %>
      <ul class="deploys">
        <% @deliveries.each do |d| %>
          <li>
            <span class="badge badge--dep-<%= d.status == 'deployed' ? 'succeeded' : 'queued' %>"><%= d.status %></span>
            <strong class="mono"><%= d.short_sha.presence || d.event %></strong>
            <span class="muted">
              <%= d.branch.presence %>
              <%= "· #{d.pusher}" if d.pusher.present? %>
              · <%= time_ago_in_words(d.created_at) %> ago
            </span>
            <% if d.message.present? %>
              <div class="muted"><%= d.message %></div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted">No deliveries received yet.</p>
    <% end %>
  </section>

  <section class="card">
    <h2>Recent deployments</h2>
    <% if @deployments.empty? %>
      <p class="muted">No deployments yet.</p>
    <% else %>
      <ul class="deploys">
        <% @deployments.each do |d| %>
          <li>
            <%= link_to app_deployment_path(@app, d) do %>
              <%= deployment_badge(d) %>
              <strong><%= d.kind %></strong>
              <span class="muted"><%= d.ref.to_s.first(10) %> · <%= time_ago_in_words(d.created_at) %> ago<%= " · #{d.duration}s" if d.duration %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
