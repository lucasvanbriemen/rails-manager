<% content_for :title, "Mail" %>

<div class="page-head">
  <div>
    <h1>Mail</h1>
    <div class="page-head__meta">
      <%= pluralize(@domains.size, "domain") %> ·
      <%= pluralize(@mailbox_count, "mailbox", plural: "mailboxes") %> ·
      <%= pluralize(@alias_count, "alias", plural: "aliases") %>
    </div>
  </div>
  <div class="head-actions">
    <%= button(text: "Rendered config", href: mail_config_path, variant: :outline) %>
    <% if can?(:create, :apps) %>
      <%= button(text: "Add domain", href: new_mail_domain_path) %>
    <% end %>
  </div>
</div>

<section class="tiles">
  <%= tile label: "Domains", value: @domains.size.to_s,
           detail: "#{@domains.count(&:accepts_mail?)} accept local delivery" %>
  <%= tile label: "Mailboxes", value: @mailbox_count.to_s,
           detail: "#{@mailbox_count - @uncredentialed} can authenticate" %>
  <%= tile label: "Aliases", value: @alias_count.to_s,
           detail: "forwarding entries" %>
  <%# A mailbox with no digest gets no line in the passwd-file, so it receives
      mail but nobody can log in. That is a state worth counting, not hiding. %>
  <%= tile label: "No password", value: @uncredentialed.to_s,
           level: (@uncredentialed.positive? ? :warn : :ok),
           detail: @uncredentialed.positive? ? "cannot authenticate until reset" : "every mailbox has a digest" %>
</section>

<% if @domains.empty? %>
  <p class="empty">No mail domains yet.</p>
<% else %>
  <section class="card">
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>Domain</th>
            <th>Delivery</th>
            <th class="table__num">Mailboxes</th>
            <th class="table__num">Aliases</th>
            <th>Catch-all</th>
            <th>DKIM</th>
          </tr>
        </thead>
        <tbody>
          <% @domains.each do |domain| %>
            <tr>
              <td>
                <%= link_to domain.name, domain, class: "table__link mono" %>
                <% unless domain.active? %><%= badge("inactive") %><% end %>
                <% if domain.configuration_gaps.any? %>
                  <%= badge("#{domain.configuration_gaps.size} issue#{"s" if domain.configuration_gaps.size > 1}", tone: :warn) %>
                <% end %>
              </td>
              <td>
                <% if domain.accepts_mail? %>
                  <%= badge("local", tone: :ok, title: "This server is the final destination for #{domain.name}") %>
                <% else %>
                  <%= badge("relayed", title: "Not in virtual_mailbox_domains — Postfix does an ordinary MX lookup") %>
                <% end %>
              </td>
              <td class="table__num"><%= domain.mailboxes.size %></td>
              <td class="table__num"><%= domain.mail_aliases.size %></td>
              <td>
                <% if domain.forwards_catch_all? %>
                  <span class="mono">→ <%= domain.catch_all_target %></span>
                <% else %>
                  <span class="muted">reject</span>
                <% end %>
              </td>
              <td>
                <%= domain.signs_dkim? ? tag.span(domain.dkim_selector, class: "mono") : tag.span("—", class: "muted") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
