<% content_for :title, @mailbox.address %>

<div class="page-head">
  <div>
    <h1 class="mono"><%= @mailbox.address %></h1>
    <div class="page-head__meta">
      <% if @mailbox.credentialed? %>
        <%= badge("password set", tone: :ok) %>
        <% if @mailbox.password_set_at %>· <%= time_ago_in_words(@mailbox.password_set_at) %><% end %>
      <% else %>
        <%= badge("no password", tone: :warn) %>
      <% end %>
      · <span class="mono"><%= @mailbox.maildir_path %></span>
    </div>
  </div>
  <div class="head-actions"><%= button(text: "← Domain", href: mail_domain_path(@domain), variant: :text) %></div>
</div>

<section class="card" id="password">
  <h2>Password</h2>

  <p class="hint">
    <% if @mailbox.credentialed? %>
      A digest is stored, so this mailbox has a line in the Dovecot passwd-file and can log in.
      There is no way to read the existing password back — only to replace it.
    <% else %>
      No digest is stored, so this mailbox has no line in the Dovecot passwd-file at all: it
      receives mail, but nothing can authenticate as it until a password is set.
    <% end %>
  </p>

  <div class="password-choice">
    <%= form_with url: set_password_mail_domain_mailbox_path(@domain, @mailbox), method: :patch,
                  html: { class: "form password-choice__form", autocomplete: "off" } do %>
      <div class="field">
        <%= label_tag "mailbox[password]", "Choose a password" %>
        <%= password_field_tag "mailbox[password]", nil, autocomplete: "new-password",
                               minlength: MailboxesController::MINIMUM_PASSWORD_LENGTH %>
      </div>
      <div class="field">
        <%= label_tag "mailbox[password_confirmation]", "Repeat it" %>
        <%= password_field_tag "mailbox[password_confirmation]", nil, autocomplete: "new-password" %>
      </div>
      <p class="field__hint">
        At least <%= MailboxesController::MINIMUM_PASSWORD_LENGTH %> characters. Stored as a
        SHA512-CRYPT digest, encrypted on top of that — it is never written down anywhere it can be
        read back, so keep your own copy.
      </p>
      <%= button(text: "Set password", type: :submit) %>
    <% end %>

    <div class="password-choice__or"><span>or</span></div>

    <div class="password-choice__generated">
      <p class="hint">
        Generate one instead: 22 characters from an alphabet with no 0/O or 1/l/I, shown once and
        never recoverable.
      </p>
      <%= button(text: @mailbox.credentialed? ? "Generate a new one" : "Generate a password",
                 href: reset_password_mail_domain_mailbox_path(@domain, @mailbox), method: :post,
                 variant: :outline,
                 data: { turbo_confirm: "Generate a new password for #{@mailbox.address}? It is shown once and the old one stops working immediately." }) %>
    </div>
  </div>
</section>

<section class="card">
  <h2>Settings</h2>
  <%= render "form", mailbox: @mailbox, domain: @domain %>
</section>
